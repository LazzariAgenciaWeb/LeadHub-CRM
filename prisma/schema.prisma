generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Usuários ─────────────────────────────────────────────────────────────────

model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  password             String
  role                 UserRole  @default(CLIENT)
  // Recuperação de senha por email: guarda o HASH (sha256) do token enviado no
  // link + validade. Limpados após o uso. Nunca guardamos o token em texto puro.
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Assinatura exibida no início das mensagens WhatsApp enviadas pelo usuário
  whatsappSignature        String?
  // Se true (default), o checkbox "Assinar como X" no compositor de mensagem
  // do WhatsApp começa marcado. Usuário pode desligar pra ter de marcar manual
  // a cada envio.
  whatsappSignatureDefault Boolean @default(true)

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?

  ticketsCreated        Ticket[]               @relation("TicketCreatedBy")
  ticketsAssigned       Ticket[]               @relation("TicketAssignee")
  companyContact        CompanyContact?        @relation("ContactUser")
  setores               SetorUser[]
  conversationsAssigned Conversation[]         @relation("ConversationAssignee")
  googleConnections     UserGoogleConnection[]
  vaultChallenges       VaultEmailChallenge[]
  vaultTrustedSessions  VaultTrustedSession[]
  userScores            UserScore[]
  userBadges            UserBadge[]
  scoreEvents           ScoreEvent[]
  projectMemberships    ProjectMember[]
  rankingCategory       RankingCategory        @default(PRODUCAO)
  // Timestamp da última vez que o user "viu" os badges — pra toast de novidades
  lastBadgeSeenAt       DateTime?
  rewardRedemptions     RewardRedemption[]
  messagesSent          Message[]              @relation("MessageSentBy")
  tasksAssigned         Task[]                 @relation("TaskAssignee")
  tasksCreated          Task[]                 @relation("TaskCreatedBy")
  projectTasksAssigned  ProjectTask[]          @relation("ProjectTaskAssignee")
  projectTasksCreated   ProjectTask[]          @relation("ProjectTaskCreatedBy")
  ticketAccess          TicketAccessUser[]
  projectAccess         ProjectAccessUser[]
  pushSubscriptions     PushSubscription[]
  notifPreferences      UserNotifPreferences?
  emailCampaignsCreated EmailCampaign[]        @relation("EmailCampaignCreatedBy")
  assistantsCreated     Assistant[]
  assistantCalendars    Assistant[] @relation("AssistantCalendarUser")

  @@index([companyId])
}

// ─── 2FA por e-mail para revelar credenciais do cofre ─────────────────────────
// Cada vez que um usuário clica "Mostrar senha" e não tem trusted session
// ativa, geramos um código de 6 dígitos e enviamos para o e-mail dele.
// Após validar, criamos uma VaultTrustedSession de 15 min que dispensa
// novos códigos no intervalo.

model VaultEmailChallenge {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash     String // SHA-256 do código (não guardamos o texto claro)
  credentialId String? // credencial alvo (auditoria; não restringe a verify)

  attempts  Int      @default(0) // máx 5 tentativas por challenge
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model VaultTrustedSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

// ─── Conexões pessoais com Google (Calendar e futuros serviços por usuário) ───
// Diferente de MarketingIntegration (por empresa, GA4/SC/GBP), aqui guardamos
// uma conexão OAuth por USUÁRIO. Cada atendente liga a própria conta Google
// para que o calendário pessoal apareça na vista "Meu Dia".

model UserGoogleConnection {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  service     String // "calendar" — extensível pra outros serviços pessoais
  googleEmail String?
  googleName  String?

  // OAuth tokens (criptografados via src/lib/crypto.ts — AES-256-GCM)
  accessTokenEnc  String?   @db.Text
  refreshTokenEnc String?   @db.Text
  tokenExpiresAt  DateTime?
  scopes          String[]  @default([])

  status     String    @default("ACTIVE") // ACTIVE | EXPIRED | DISCONNECTED | ERROR
  lastError  String?   @db.Text
  lastSyncAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, service])
  @@index([userId])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN // admin da empresa (gerencia usuários, setores, config)
  CLIENT // agente/atendente — permissões controladas pelo setor
}

// Categoria do ranking — separa Produção (atendentes/operação) de Gestão
// (gerentes/diretores). Cada categoria tem leaderboard próprio.
enum RankingCategory {
  PRODUCAO
  GESTAO
}

// ─── Empresas ─────────────────────────────────────────────────────────────────

model Company {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  segment   String?
  phone     String?
  email     String?
  website   String?
  logoUrl   String?
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Acesso ao sistema e módulos habilitados
  hasSystemAccess      Boolean @default(false) // pode fazer login? (vê o "Meu Espaço" — painel do cliente)
  fullSystemAccess     Boolean @default(false) // além do Meu Espaço, acessa o LeadHub completo (módulos/menus). Se false = só o painel.
  moduleWhatsapp       Boolean @default(false)
  moduleCrm            Boolean @default(true)
  moduleTickets        Boolean @default(false)
  moduleAI             Boolean @default(false)
  moduleGamificacao    Boolean @default(false)
  moduleProjetos       Boolean @default(false)
  moduleCalendario     Boolean @default(false)
  // Disparo de email em massa (campanhas). Quando ligado, a empresa configura
  // o próprio SMTP em CompanyEmailConfig e dispara campanhas pros leads.
  moduleEmailMarketing Boolean @default(false)
  // Habilita busca de prospects via SerpAPI (Google Maps + scraper inline)
  // na página /crm/prospeccao. Cada empresa traz a própria `serpapiKey`.
  moduleProspeccao     Boolean @default(false)
  // API key SerpAPI da empresa (texto plano, mesmo padrão dos tokens de
  // integração atuais). Sem key, o botão "Buscar prospects" não aparece.
  serpapiKey           String?
  // Habilita a integração com ClickUp pra esta empresa. Quando false, a UI
  // de configuração e a sincronização (push + webhook) ficam desligadas.
  // Cada empresa-cliente liga o módulo e configura a própria conta ClickUp.
  moduleClickup        Boolean @default(false)
  // Módulo Campanhas (gerenciar campanhas + UTMs vinculadas a leads)
  moduleCampanhas      Boolean @default(false)
  // Módulo Links de rastreio (gera tracking links com pixel)
  moduleLinks          Boolean @default(false)
  // Módulo Instagram (automação estilo ManyChat): conecta a conta IG
  // Profissional via "API com Login do Instagram" e dispara respostas a
  // comentários + DM (private reply). Cada empresa conecta a própria conta.
  moduleInstagram      Boolean @default(false)
  // Módulo "Espaço do Cliente": permite a AGÊNCIA oferecer o painel do cliente —
  // gerar o link público /c/[token] e liberar login no Meu Espaço pros clientes
  // dela (sub-empresas). Habilitado pelo SUPER_ADMIN por agência.
  moduleEspacoCliente  Boolean @default(false)
  // Módulo "Vídeos" (biblioteca estilo Netflix): material de apoio em vídeo
  // (YouTube embed) organizado em trilhas. SUPER_ADMIN mantém a biblioteca
  // central e libera trilhas por empresa; agências com o módulo podem criar
  // trilhas próprias pros clientes delas. Cliente assiste no /meu-espaco/videos.
  moduleVideos         Boolean @default(false)

  // Define se a empresa usa WhatsApp em modo VISAO (read-only / painel de contexto)
  // ou ATENDE (completo, envia pelo painel). Default ATENDE preserva comportamento
  // das contas existentes — só contas novas no plano de entrada nascem como VISAO.
  modoAtendimento ModoAtendimento @default(ATENDE)

  // ─── Cota de uso de IA (Assistentes) ──────────────────────────────────────
  // A key da OpenAI é GLOBAL (do sistema). O controle de consumo é por empresa:
  // 1 "interação" = 1 chamada de IA (sugestão/resposta). Cota mensal que reseta.
  // aiMonthlyQuota  = limite de interações/mês (0 = bloqueado; setado pelo admin).
  // aiUsedThisMonth = contador do período atual.
  // aiQuotaResetAt  = quando o contador zera (início do próximo período mensal).
  aiMonthlyQuota  Int       @default(0)
  aiUsedThisMonth Int       @default(0)
  aiQuotaResetAt  DateTime?

  // Hierarquia: empresa-pai gerencia sub-empresas (clientes da empresa)
  parentCompanyId String?
  parentCompany   Company?  @relation("SubCompanies", fields: [parentCompanyId], references: [id])
  subCompanies    Company[] @relation("SubCompanies")

  users                     User[]
  userScores                UserScore[]
  userBadges                UserBadge[]
  scoreEvents               ScoreEvent[]
  scoreRuleConfigs          ScoreRuleConfig[]
  setorClickupListsAsClient SetorClickupList[]    @relation("SetorClickupListClient")
  rewards                   Reward[]
  rewardRedemptions         RewardRedemption[]
  businessHours             BusinessHoursConfig[]
  campaigns                 Campaign[]
  leads                     Lead[]
  tasks                     Task[]
  tags                      Tag[]
  customFieldDefs           CustomFieldDef[]
  emailConfig               CompanyEmailConfig?
  emailTemplates            EmailTemplate[]
  emailCampaigns            EmailCampaign[]
  emailUnsubscribes         EmailUnsubscribe[]
  // Triagem IA automática da caixa de email no poller (consome cota de IA a
  // cada rodada com email novo). Default OFF — o botão "Resumo IA" manual
  // sempre funciona; este flag só controla o disparo automático.
  emailAiTriageAuto         Boolean               @default(false)

  emailAccounts           EmailAccount[]
  inboxEmails             InboxEmail[]
  inboxSenderRules        InboxSenderRule[]
  inboxEmailTags          InboxEmailTag[]
  // Campos personalizados definidos por este tenant — aplicam-se às próprias
  // empresas-cliente (sub-empresas) e à própria empresa.
  companyFieldDefs        CompanyCustomFieldDef[]  @relation("CompanyFieldDefOwner")
  companyCustomValues     CompanyCustomValue[]
  whatsappInstances       WhatsappInstance[]
  messages                Message[]
  keywordRules            KeywordRule[]
  tickets                 Ticket[]
  ticketsAsClient         Ticket[]                 @relation("TicketClientCompany")
  clientServices          ClientService[]          @relation("ClientServiceClient")
  clientInvoices          ClientInvoice[]          @relation("ClientInvoiceClient")
  trackingLinks           TrackingLink[]
  pipelineStages          PipelineStageConfig[]
  contacts                CompanyContact[]
  setores                 Setor[]
  conversations           Conversation[]
  activities              Activity[]
  assets                  CompanyAsset[]
  credentialAccessLogs    CredentialAccessLog[]
  secureNotes             CompanySecureNote[]
  secureNoteAccessLogs    SecureNoteAccessLog[]
  marketingIntegrations   MarketingIntegration[]
  metaConversionConfig    MetaConversionConfig?
  metaConversionLogs      MetaConversionLog[]
  instagramAccounts       InstagramAccount[]
  igAutomations           IgAutomation[]
  igAutomationRuns        IgAutomationRun[]
  igConversations         IgConversation[]
  facebookPages           FacebookPage[]
  analyticsSnapshots      AnalyticsSnapshot[]
  analyticsTopPages       AnalyticsTopPage[]
  analyticsTrafficSources AnalyticsTrafficSource[]
  analyticsGeoData        AnalyticsGeoData[]
  analyticsEventDaily     AnalyticsEventDaily[]
  marketingEventConfig    MarketingEventConfig[]
  searchConsoleQueries    SearchConsoleQuery[]
  gbpInsights             GbpInsight[]
  gbpReviews              GbpReview[]
  gbpSearchKeywords       GbpSearchKeyword[]
  gbpProfileSnapshots     GbpProfileSnapshot[]
  adCampaignDailies       AdCampaignDaily[]
  adSearchTermDailies     AdSearchTermDaily[]
  adCreatives             AdCreative[]
  adCreativeDailies       AdCreativeDaily[]
  subscription            Subscription?
  billingEvents           BillingEvent[]
  addons                  SubscriptionAddon[]
  couponRedemptions       CouponRedemption[]
  assistants              Assistant[]
  scheduledMessages       ScheduledMessage[]
  aiUsageLogs             AiUsageLog[]
  services                Service[]
  videoCategories         VideoCategory[]          @relation("CompanyVideoCategories")
  videoReleases           VideoCategoryRelease[]   @relation("CompanyVideoReleases")
  triggerOnly             Boolean                  @default(false)
  webhookToken            String?                  @unique // token público para receber leads via webhook

  @@index([parentCompanyId])
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

// Modo de operação do WhatsApp para a empresa.
// VISAO  = somente leitura (espelho). Substitui o input de mensagem por
//          painel de contexto do lead. Equipe responde pelo celular.
// ATENDE = comportamento atual (envia, templates, transferência etc.).
enum ModoAtendimento {
  VISAO
  ATENDE
}

// ─── Campanhas ────────────────────────────────────────────────────────────────

model Campaign {
  id          String         @id @default(cuid())
  name        String
  slug        String
  description String?
  source      CampaignSource @default(OTHER)
  status      CampaignStatus @default(ACTIVE)
  budget      Float?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  leads        Lead[]
  messages     Message[]
  links        TrackingLink[]
  keywordRules KeywordRule[]

  @@unique([companyId, slug])
  @@index([companyId])
}

enum CampaignSource {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  GOOGLE
  LINK
  OTHER
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  FINISHED
}

// ─── Links de Rastreio ────────────────────────────────────────────────────────

model TrackingLink {
  id            String   @id @default(cuid())
  code          String   @unique
  label         String?
  destination   String
  destType      String   @default("url")
  clicks        Int      @default(0)
  // Quando false, o link permanece cadastrado e cliques continuam sendo
  // registrados (pra saber que o cliente tentou abrir), mas a página /r/CODE
  // não redireciona pro destino — mostra "proposta encerrada".
  isActive      Boolean  @default(true)
  ogTitle       String?
  ogDescription String?  @db.Text
  ogImage       String?
  createdAt     DateTime @default(now())

  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?

  leads       Lead[]
  clickEvents ClickEvent[]

  @@index([campaignId])
  @@index([companyId])
}

model ClickEvent {
  id             String         @id @default(cuid())
  trackingLink   TrackingLink   @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)
  trackingLinkId String
  targetUrl      String         @db.Text
  targetLabel    String?
  // OPEN  = cliente abriu o shortlink /r/CODE (entrou na proposta/landing)
  // INTERNAL = clicou em algum link/CTA DENTRO da página de destino (pixel script)
  kind           ClickEventKind @default(INTERNAL)
  createdAt      DateTime       @default(now())

  @@index([trackingLinkId])
  @@index([trackingLinkId, kind])
}

enum ClickEventKind {
  OPEN
  INTERNAL
}

// ─── Leads ────────────────────────────────────────────────────────────────────

model Lead {
  id        String     @id @default(cuid())
  name      String?
  phone     String
  email     String?
  source    String?
  status    LeadStatus @default(NEW)
  notes     String?    @db.Text
  value     Float?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // CRM Pipeline
  pipeline      String? // "PROSPECCAO" | "LEADS" | "OPORTUNIDADES"
  pipelineStage String? // nome da etapa configurável
  externalId    String? // ID externo (ex: id do Supabase BDR para evitar duplicatas)

  // Dados de prospect (preenchidos pela busca SerpAPI + scraper inline em /crm/prospeccao)
  website            String?
  instagram          String?
  facebook           String?
  address            String?
  city               String?
  segment            String? // categoria/segmento (ex: "Clínica Pediátrica", vem do `type` do Google Maps)
  // Validação Evolution: NULL = não validado, true/false = checado em /chat/whatsappNumbers
  hasWhatsapp        Boolean?
  // Diagnóstico IA (Prospecta IA → /api/prospeccao/diagnose). JSON com summary,
  // positives[], opportunities[], criticals[], sourceData{}. Token público leva
  // pro /d/[token] que mostra a análise e auto-promove o prospect pra LEADS no clique.
  diagnosis          Json?
  diagnosisAt        DateTime?
  diagnosisSource    String? // "website" | "instagram" | "none"
  diagnosisToken     String?   @unique
  diagnosisClickedAt DateTime?

  // Atendimento WhatsApp
  // @deprecated — espelho legacy de Conversation.status (mantido pra UI antiga via sync automático).
  // Leitura nova deve usar `lead.conversation.status`. Remover em migration futura.
  attendanceStatus String? // "WAITING" | "IN_PROGRESS" | "RESOLVED" | "SCHEDULED"
  expectedReturnAt DateTime? // previsão de retorno quando agendado

  // Integração ClickUp
  clickupTaskId String? // ID ou URL da tarefa no ClickUp

  // Visibilidade: isInternal=true → visível apenas ao SUPER_ADMIN (não aparece no portal do cliente)
  isInternal Boolean @default(false)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  campaignId String?

  trackingLink   TrackingLink? @relation(fields: [trackingLinkId], references: [id])
  trackingLinkId String?

  // ─── Rastreabilidade da promoção entre pipelines (atribuição) ─────────────
  // Setado pelos handlers de clique (shortlink e email) quando movem o lead
  // automático entre pipelines — alimenta relatórios de conversão.
  promotedFromPipeline       String? // "PROSPECCAO" | "LEADS"
  promotedAt                 DateTime?
  promotedReason             String? // "link_click" | "email_click" | "whatsapp_reply"
  promotedViaEmailCampaign   EmailCampaign? @relation("CampaignPromotedLeads", fields: [promotedViaEmailCampaignId], references: [id], onDelete: SetNull)
  promotedViaEmailCampaignId String?

  // ─── Sinais de atribuição do Meta (Conversions API) ──────────────────────
  // Preenchidos quando o lead entra por uma landing com o Pixel do Meta (via
  // webhook) ou pelo shortlink /r/CODE que carrega o fbclid. Melhoram MUITO o
  // match no CAPI vs. só email/telefone. fbc/fbp vão puros (não hasheados);
  // ip/user-agent idem. Quando algum existe, o evento vira action_source=website.
  fbc             String? // cookie _fbc (fb.1.<ts>.<fbclid>)
  fbp             String? // cookie _fbp do Pixel
  eventSourceUrl  String? // URL da landing onde o lead converteu
  clientIp        String? // IP do visitante no momento da conversão
  clientUserAgent String? @db.Text // user-agent do visitante

  // Conversa unificada (uma conversa por telefone × empresa, criada no Sprint 1)
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  conversationId String?

  messages        Message[]
  comments        LeadComment[]
  activities      Activity[]
  tasks           Task[]
  tags            LeadTag[]
  customValues    LeadCustomValue[]
  emailRecipients EmailRecipient[]
  inboxEmails     InboxEmail[]

  @@index([companyId])
  @@index([campaignId])
  @@index([phone, companyId])
  @@index([pipeline, companyId])
  @@index([externalId])
  @@index([conversationId])
}

// Tag colorida atribuível a leads. Configurada por empresa (cada empresa
// monta as próprias categorias: "VIP", "Quente", "Aguardando docs"…).
model Tag {
  id    String @id @default(cuid())
  name  String
  // Hex color usada nas chips. Default: indigo (combina com o tema).
  color String @default("#6366f1")
  // Ordem de exibição. Default 0 — usuário pode arrastar pra reordenar depois.
  order Int    @default(0)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  leads LeadTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Não duplicar tag com mesmo nome dentro da mesma empresa.
  @@unique([companyId, name])
  @@index([companyId, order])
}

// Pivot N:N Lead↔Tag. Composta como PK pra evitar duplicatas naturalmente.
model LeadTag {
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String

  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId String

  createdAt DateTime @default(now())

  @@id([leadId, tagId])
  @@index([tagId])
}

// ─── Custom Fields ────────────────────────────────────────────────────────────
// Cada empresa-cliente define os campos extras que faz sentido pra ela
// (clínica = "Convênio", imobiliária = "Tipo do imóvel", agência = "Verba mensal").
// CustomFieldDef é a definição (metadata); LeadCustomValue guarda o valor por lead.

model CustomFieldDef {
  id       String          @id @default(cuid())
  // Nome legível ("Convênio", "Tipo do imóvel"). Pode mudar sem quebrar nada.
  name     String
  // Identificador estável usado na URL/API. Slug do nome no momento da criação.
  // Não duplicar na mesma empresa.
  key      String
  type     CustomFieldType @default(TEXT)
  // Pra type=SELECT: array JSON de strings. Ex: ["Unimed","Bradesco","Particular"].
  options  Json?
  required Boolean         @default(false)
  // Ordem de exibição no drawer. Menor primeiro.
  order    Int             @default(0)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  values LeadCustomValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
  @@index([companyId, order])
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  LINK
}

model LeadCustomValue {
  id String @id @default(cuid())

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String

  field   CustomFieldDef @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  fieldId String

  // Valor sempre como texto — interpretação fica a cargo do `field.type`.
  // Pra DATE guarda ISO string; pra NUMBER guarda string numérica; SELECT
  // guarda o valor escolhido (uma das `options`). Simplifica muito o schema.
  value String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Um valor por (lead, field).
  @@unique([leadId, fieldId])
  @@index([fieldId])
}

// ─── Campos personalizados de EMPRESA ─────────────────────────────────────────
// Mesma ideia do CustomFieldDef (que é pra Lead), mas o alvo aqui é a própria
// `Company`. Definição pertence a um "tenant" (a empresa-dona, normalmente a
// agência que opera o LeadHub) e aplica-se a si mesma + às sub-empresas dela.
// Cada usuário da agência pode criar campos conforme o atendimento exigir
// (ex.: "Plano contratado", "Data de renovação", "Driver Stripe").

model CompanyCustomFieldDef {
  id      String          @id @default(cuid())
  name    String
  key     String
  type    CustomFieldType @default(TEXT)
  options Json?
  order   Int             @default(0)

  // Tenant que definiu o campo (a agência). Os campos visíveis em uma empresa
  // são os do parentCompanyId dela (ou os dela mesma se for top-level).
  ownerCompany   Company @relation("CompanyFieldDefOwner", fields: [ownerCompanyId], references: [id], onDelete: Cascade)
  ownerCompanyId String

  values CompanyCustomValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerCompanyId, key])
  @@index([ownerCompanyId, order])
}

model CompanyCustomValue {
  id String @id @default(cuid())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  field   CompanyCustomFieldDef @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  fieldId String

  value String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, fieldId])
  @@index([fieldId])
}

// Tarefa de follow-up de um lead (ligar, mandar proposta, agendar reunião…)
// Modelo simples e propositalmente enxuto — vendedor abre o sistema, vê
// "minhas tarefas de hoje", marca como feita e segue. Sem recorrência por agora.
model Task {
  id     String    @id @default(cuid())
  title  String
  dueAt  DateTime
  done   Boolean   @default(false)
  doneAt DateTime?
  notes  String?   @db.Text

  // Origem da tarefa: criada por humano ou disparada automaticamente
  // (ex: cliente abriu o link rastreado). Usado pra UI marcar "🔥 sinal quente"
  // e pra cooldowns de auto-criação.
  source TaskSource @default(MANUAL)

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  // Quem deve executar. Opcional — null = "qualquer um do setor pode pegar".
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId String?

  // Quem criou (auditoria, gamificação). Null = sistema.
  createdBy   User?   @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, done, dueAt])
  @@index([assigneeId, done, dueAt])
  @@index([leadId])
  @@index([leadId, source, done, createdAt])
}

enum TaskSource {
  MANUAL
  AUTO_LINK_OPEN // disparada quando cliente abriu o shortlink (proposta etc.)
}

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL
  CLOSED
  LOST
}

// ─── Comentários de Lead ──────────────────────────────────────────────────────

model LeadComment {
  id         String   @id @default(cuid())
  body       String   @db.Text
  authorName String   @default("Usuário")
  createdAt  DateTime @default(now())

  // Origem do comentário (pra dedup quando vem do ClickUp via webhook).
  // "LEADHUB" (default) | "CLICKUP"
  source     String  @default("LEADHUB")
  externalId String? // ID do comentário no ClickUp (evita criar duplicado em sync)

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String

  @@index([leadId])
  @@index([externalId])
}

// ─── Etapas de Pipeline Configuráveis ────────────────────────────────────────

model PipelineStageConfig {
  id       String       @id @default(cuid())
  pipeline String // "PROSPECCAO" | "LEADS" | "OPORTUNIDADES"
  name     String
  color    String       @default("#6366f1")
  order    Int          @default(0)
  isFinal  Boolean      @default(false) // FECHADO / PERDIDO — etapas de encerramento
  // Resultado comercial da etapa (independe do pipeline). GANHO = venda fechada:
  // dispara o evento de conversão pro Meta (Conversions API) e conta como venda
  // na gamificação — funciona em QUALQUER pipeline (inclusive clientes que só
  // têm LEADS, sem OPORTUNIDADES). PERDIDO = perda. NEUTRO = etapa normal.
  // Marcar GANHO/PERDIDO implica isFinal=true (garantido na API).
  outcome  StageOutcome @default(NEUTRO)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  @@index([companyId, pipeline])
}

enum StageOutcome {
  NEUTRO
  GANHO
  PERDIDO
}

// ─── Contatos da Empresa (WhatsApp) ──────────────────────────────────────────

model CompanyContact {
  id        String   @id @default(cuid())
  name      String? // nome do contato / grupo
  phone     String // número (55...) ou group-id (@g.us)
  isGroup   Boolean  @default(false) // true = grupo do WhatsApp
  role      String   @default("CONTACT") // "CONTACT" | "DECISION_MAKER" | "TECHNICAL" | "FINANCIAL"
  hasAccess Boolean  @default(false) // acesso ao portal do cliente
  notes     String?
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  // Quando hasAccess = true, pode ter um User vinculado (login no portal)
  user   User?   @relation("ContactUser", fields: [userId], references: [id])
  userId String? @unique

  @@unique([companyId, phone])
  @@index([companyId])
}

// ─── Instâncias WhatsApp ──────────────────────────────────────────────────────

model WhatsappInstance {
  id            String         @id @default(cuid())
  // Slug técnico usado na Evolution API (auto-gerado, único, sem acento/espaço).
  // É a chave que casa mensagem↔instância em todo o sistema — não editar à mão.
  instanceName  String
  // Nome amigável que o usuário digita e vê na tela de gestão.
  // Fallback para instanceName quando ausente (instâncias antigas).
  label         String?
  phone         String?
  status        InstanceStatus @default(DISCONNECTED)
  webhookUrl    String?
  instanceToken String? // token da instância na Evolution API (para auth em endpoints específicos)
  // Aceita receber webhooks de mensagens de grupo. Default true (compat).
  // Quando false, sincroniza com Evolution `groupsIgnore=true` — a instância
  // permanece dentro dos grupos no WhatsApp e ainda pode enviar, mas para de
  // disparar webhook a cada mensagem. Útil em empresa com várias instâncias
  // nos mesmos grupos: deixa só 1 receptora, evita duplicação de processamento.
  acceptGroups  Boolean        @default(true)
  // Instância RECEPTORA de grupos da empresa. No máximo 1 por empresa (regra
  // aplicada no endpoint PATCH, não no banco). Quando alguma instância da
  // empresa está marcada, o webhook SÓ persiste mensagem de grupo (@g.us) que
  // chegou por ela — as demais continuam com acceptGroups=true (sincronizadas,
  // podendo ENVIAR sem "Aguardando mensagem"), mas seus ecos de grupo são
  // descartados. Desacopla "quem recebe" de "quem pode responder", evitando a
  // bagunça de contato quando várias instâncias estão nos mesmos grupos.
  // Se nenhuma instância da empresa estiver marcada, mantém o comportamento
  // antigo (toda instância com acceptGroups=true processa grupo).
  groupReceiver Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  messages   Message[]
  setores    SetorInstance[]
  assistants Assistant[]
  scheduledMessages ScheduledMessage[]

  @@index([companyId])
}

enum InstanceStatus {
  CONNECTED
  DISCONNECTED
  CONNECTING
}

// ─── Mensagens WhatsApp ───────────────────────────────────────────────────────

model Message {
  id               String      @id @default(cuid())
  externalId       String?     @unique
  phone            String // telefone individual ou JID do grupo (@g.us)
  participantPhone String? // quem enviou dentro do grupo (preenchido só para mensagens de grupo)
  participantName  String? // nome do participante do grupo (pushName da Evolution API)
  body             String      @db.Text
  direction        MessageDir  @default(INBOUND)
  identifiedAs     LeadStatus?
  processed        Boolean     @default(false)
  rawPayload       Json?
  receivedAt       DateTime    @default(now())
  ack              Int? // ACK: 0=pending 1=server 2=delivered 3=read 4=played
  quotedId         String? // externalId da mensagem citada
  quotedBody       String?     @db.Text // snapshot do corpo da mensagem citada
  mediaBase64      String?     @db.Text // base64 da mídia (imagem/áudio) — vídeo/doc ignorados por tamanho
  mediaType        String? // MIME type: "image/jpeg", "audio/ogg; codecs=opus", etc.

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  instance   WhatsappInstance? @relation(fields: [instanceId], references: [id])
  instanceId String?

  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  campaignId String?

  lead   Lead?   @relation(fields: [leadId], references: [id])
  leadId String?

  // Conversa unificada — populada pelo backfill (Sprint 1) e por toda mensagem nova (Sprint 2)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String?

  // User que enviou a mensagem OUTBOUND (atendente). Visível só na UI interna
  // do LeadHub — auditoria e identificação de quem operou. Nullable para
  // mensagens antigas e mensagens automáticas (campanha, sistema).
  sentBy       User?   @relation("MessageSentBy", fields: [sentByUserId], references: [id])
  sentByUserId String?

  @@index([companyId])
  // Cobre `WHERE phone = X AND companyId = Y ORDER BY receivedAt DESC LIMIT N`
  // (rota /api/whatsapp/messages — abrir conversa). Substituiu o antigo
  // (phone, companyId) — Postgres usa prefixo, então queries que filtram só
  // pelos 2 primeiros continuam cobertas, e adicionou ordering pra evitar
  // sort em memória de 5k+ mensagens em grupos grandes.
  @@index([phone, companyId, receivedAt])
  @@index([processed])
  @@index([conversationId, receivedAt])
  @@index([sentByUserId])
}

enum MessageDir {
  INBOUND
  OUTBOUND
}

// ─── Regras de Identificação ──────────────────────────────────────────────────

model KeywordRule {
  id        String           @id @default(cuid())
  keyword   String
  mapTo     LeadStatus
  // CONTAINS: dispara quando a mensagem contém a expressão (busca parcial, padrão antigo).
  // EXACT: dispara apenas quando a mensagem (após trim/lower) é igual à expressão.
  matchMode KeywordMatchMode @default(CONTAINS)
  priority  Int              @default(0)
  createdAt DateTime         @default(now())

  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?

  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId String?

  @@index([companyId])
  @@index([campaignId])
}

enum KeywordMatchMode {
  CONTAINS
  EXACT
}

// ─── Configurações Globais ────────────────────────────────────────────────────

model Setting {
  key   String @id
  value String @db.Text
}

// Contador diário de mensagens enviadas por instância — protege contra
// banimento por uso de bot detectado pelo WhatsApp. Reseta naturalmente
// porque cada (instanceId, day) é uma linha nova.
model WhatsappQuota {
  id         String @id @default(cuid())
  instanceId String
  day        String // YYYY-MM-DD
  count      Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instanceId, day])
  @@index([day])
}

// ─── Conversation (CRM-style inbox) ──────────────────────────────────────────
// Uma Conversation envolve TODAS as mensagens trocadas com um telefone
// (individual ou grupo) dentro de uma empresa. Status, atribuição e SLA
// vivem aqui — não mais em Lead.attendanceStatus.

model Conversation {
  id String @id @default(cuid())

  // Identificação (telefone individual ou JID do grupo)
  phone   String
  isGroup Boolean @default(false)

  // Status e fluxo de atendimento
  status          ConversationStatus @default(OPEN)
  statusUpdatedAt DateTime           @default(now())

  // Atribuição
  assigneeId String? // User responsável (atendente que pegou)
  assignee   User?   @relation("ConversationAssignee", fields: [assigneeId], references: [id])
  setorId    String? // setor responsável (herdado da primeira instância que recebeu)
  setor      Setor?  @relation(fields: [setorId], references: [id])

  // Pré-cálculo da última mensagem (ordenação eficiente sem subquery)
  lastMessageAt        DateTime?
  lastMessageBody      String?     @db.Text
  lastMessageDirection MessageDir?
  unreadCount          Int         @default(0) // mensagens INBOUND não lidas pelo atendente

  // Retorno agendado
  scheduledReturnAt DateTime? // data/hora do retorno agendado (usado quando status=SCHEDULED)
  returnNote        String? // nota/motivo do agendamento

  // Gamificação — admin pode desligar pontos pra conversas internas (grupos
  // do time, testes etc). Default false = pontua normal.
  excludeFromGamification Boolean @default(false)

  // Agente de IA autônomo — máquina de estado do bot NESTA conversa.
  //   ACTIVE       → bot pode responder (se a instância tiver agente autoRespond)
  //   PAUSED_HUMAN → humano assumiu (outbound de atendente ou handoff) — bot cala
  //   OFF          → bot desligado manualmente nesta conversa
  aiMode     AiMode    @default(ACTIVE)
  aiPausedAt DateTime? // quando o bot foi pausado (handoff/humano)

  // SLA
  firstResponseAt DateTime? // primeira resposta do atendente (calcula tempo de resposta)
  closedAt        DateTime?

  // Multi-tenant
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  // Metadados
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações inversas
  messages   Message[]
  notes      ConversationNote[]
  activities Activity[]
  leads      Lead[]

  @@unique([companyId, phone])
  @@index([companyId, status])
  @@index([companyId, lastMessageAt])
  @@index([assigneeId])
  @@index([setorId])
}

enum ConversationStatus {
  OPEN // 🆕 nova, aguardando ação (cyan)
  PENDING // 🔴 sem atendimento (passou SLA)
  IN_PROGRESS // 🟡 atendente atribuído e ativo
  WAITING_CUSTOMER // 🔵 respondemos, esperando cliente
  SCHEDULED // 🟣 standby — retorno agendado (usa Lead.expectedReturnAt como prazo)
  CLOSED // ⚪ finalizada
}

enum AiMode {
  ACTIVE // bot pode responder
  PAUSED_HUMAN // humano assumiu — bot em silêncio
  OFF // desligado manualmente nesta conversa
}

model ConversationNote {
  id         String   @id @default(cuid())
  body       String   @db.Text
  authorId   String?
  authorName String   @default("Sistema")
  // Tipo da nota — controla apresentação visual no chat:
  //   STANDARD  → amarelo/âmbar (anotação manual do atendente)
  //   SCHEDULED → roxo  (auto-gerada quando se agenda retorno)
  //   SYSTEM    → cinza (eventos automáticos diversos)
  type       String   @default("STANDARD")
  createdAt  DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  @@index([conversationId])
}

// ─── Activity (log universal) ─────────────────────────────────────────────────
// Registra eventos relevantes em Conversation, Lead ou Ticket. É o que
// alimenta a "linha do tempo" no modal e dashboards. NÃO duplica Message —
// mensagens vivem em Message; aqui ficam mudanças de estado, atribuições etc.

model Activity {
  id         String       @id @default(cuid())
  type       ActivityType
  body       String?      @db.Text
  meta       Json?
  authorId   String?
  authorName String?
  createdAt  DateTime     @default(now())

  // Pode pertencer a Conversation, Lead, Ticket (nullable — pelo menos um deve estar setado)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String?
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId         String?
  ticket         Ticket?       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId       String?

  // Multi-tenant
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  @@index([conversationId, createdAt])
  @@index([leadId, createdAt])
  @@index([ticketId, createdAt])
  @@index([companyId, createdAt])
}

enum ActivityType {
  STATUS_CHANGED
  ASSIGNEE_CHANGED
  SECTOR_CHANGED
  STAGE_CHANGED
  PIPELINE_CHANGED
  VALUE_CHANGED
  NOTE_ADDED
  CLICKUP_LINKED
  TRACKING_LINK_SET
  LEAD_LINKED
  CONVERSATION_REOPENED
  CONVERSATION_CLOSED
  TRANSFERRED
  // Extensível conforme necessário
}

// ─── Chamados (Helpdesk) ──────────────────────────────────────────────────────

model Ticket {
  id            String         @id @default(cuid())
  title         String
  description   String         @db.Text
  status        TicketStatus   @default(OPEN)
  priority      TicketPriority @default(MEDIUM)
  category      String?
  phone         String? // telefone WhatsApp de origem (quando criado via WhatsApp)
  clickupTaskId String? // ID ou URL da tarefa no ClickUp
  ticketStage   String? // etapa configurável do kanban de chamados
  // Visibilidade: isInternal=true → visível apenas ao SUPER_ADMIN (não aparece no portal do cliente)
  isInternal    Boolean        @default(false)

  // Tipo do registro:
  //   SUPPORT  — chamado de cliente externo (default, fluxo tradicional)
  //   INTERNAL — tarefa interna / afazer pessoal (sem cliente vinculado, fora do ClickUp)
  type String @default("SUPPORT")

  // Prazo previsto pra dar retorno/encerrar. Obrigatório no novo fluxo (validado
  // no API), mas mantido nullable no banco pra não quebrar registros antigos.
  dueDate DateTime?

  // Empresa-cliente do chamado (FOR quem é o atendimento). Diferente de
  // companyId, que é a empresa-dona do ticket (a agência). Para INTERNAL, null.
  clientCompany   Company? @relation("TicketClientCompany", fields: [clientCompanyId], references: [id])
  clientCompanyId String?

  // Atendente responsável (mesmo padrão da Conversation). Opcional.
  assignee   User?   @relation("TicketAssignee", fields: [assigneeId], references: [id])
  assigneeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  createdBy   User?   @relation("TicketCreatedBy", fields: [createdById], references: [id])
  createdById String?

  // Setor responsável — quem não pertence ao setor não enxerga o chamado
  setor   Setor?  @relation(fields: [setorId], references: [id])
  setorId String?

  // Projeto ao qual o chamado foi agrupado. Quando vinculado a um projeto com
  // ClickUp, a task do chamado vive na lista do projeto (não na lista padrão).
  projeto   SetorClickupList? @relation("TicketProjeto", fields: [projetoId], references: [id], onDelete: SetNull)
  projetoId String?

  // Visibilidade: "OPEN" (toda a empresa vê) | "RESTRICTED" (só setor do chamado
  // + pessoas extras em accessUsers + assignee/criador). ADMIN/SUPER_ADMIN sempre
  // veem. Default OPEN mantém compat com chamados antigos.
  visibility String @default("OPEN")

  messages    TicketMessage[]
  activities  Activity[]
  accessUsers TicketAccessUser[]
  inboxEmails InboxEmail[]

  @@index([companyId])
  @@index([status])
  @@index([setorId])
  @@index([assigneeId])
  @@index([clientCompanyId])
  @@index([dueDate])
  @@index([projetoId])
}

model TicketMessage {
  id         String  @id @default(cuid())
  body       String  @db.Text
  isInternal Boolean @default(false)
  authorName String
  authorRole String  @default("CLIENT")

  // Anexos de imagem em base64 — mesmo padrão de Message do WhatsApp.
  // Mantemos no DB pra simplificar (sem storage externo). Vídeos/docs grandes
  // devem ser linkados em vez de embutidos.
  mediaBase64 String? @db.Text
  mediaType   String? // MIME: "image/jpeg", "image/png", etc.

  // Origem da mensagem (pra audit + dedup quando vem do ClickUp).
  // "LEADHUB" (default) | "CLICKUP" | "CLIENT_PORTAL"
  source     String  @default("LEADHUB")
  externalId String? // ID do comentário no ClickUp (evita criar duplicado em sync)

  createdAt DateTime @default(now())

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  @@index([ticketId])
  @@index([externalId])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── Setores (controle de acesso interno por departamento) ────────────────────

model Setor {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  // Permissões do setor
  canManageUsers     Boolean @default(false) // cadastrar/editar usuários
  canViewLeads       Boolean @default(true) // ver prospects/leads/oportunidades
  canCreateLeads     Boolean @default(false) // cadastrar/mover leads
  canViewTickets     Boolean @default(true) // ver chamados do setor
  canCreateTickets   Boolean @default(true) // abrir chamados
  canViewConfig      Boolean @default(false) // acessar configurações
  canUseAI           Boolean @default(false) // usar Assistente IA e sugestões
  canViewInbox       Boolean @default(true) // acessar caixa de entrada WhatsApp
  canSendMessages    Boolean @default(true) // enviar mensagens WhatsApp
  canViewCompanies   Boolean @default(false) // ver lista de empresas/clientes
  canCreateCompanies Boolean @default(false) // cadastrar novas empresas
  // Permissões de módulo (gate da Sidebar, gateadas pelos módulos da empresa).
  // Default true mantém compat — empresas que ligam módulo já distribuíam acesso
  // a todos os usuários. Admin pode restringir setor a setor.
  canViewCalendario  Boolean @default(true) // ver Calendário
  canViewMarketing   Boolean @default(true) // ver Dashboard de Marketing
  canViewCampanhas   Boolean @default(true) // ver Campanhas
  canViewProjetos    Boolean @default(true) // ver Projetos
  canViewRanking     Boolean @default(true) // ver Ranking de gamificação
  canViewLinks       Boolean @default(true) // ver Links de rastreamento
  canViewCofre       Boolean @default(true) // ver Cofre (2FA continua valendo por credencial)

  users           SetorUser[]
  instances       SetorInstance[]
  tickets         Ticket[]
  conversations   Conversation[]
  clickupLists    SetorClickupList[]
  assistantRoutes AssistantRoute[]

  @@index([companyId])
}

// Project: lista do ClickUp atrelada a um setor com gestão própria de prazo,
// status e equipe. Tarefas detalhadas vivem no ClickUp; o LeadHub controla
// o nível "macro" (entrega, prazo, membros).
//
// Mantém o nome SetorClickupList por compatibilidade com a migration anterior;
// representa um Project completo.
model SetorClickupList {
  id      String @id @default(cuid())
  setorId String
  setor   Setor  @relation(fields: [setorId], references: [id], onDelete: Cascade)

  // Opcional. Quando vazio, o projeto vive só no LeadHub (tarefas nativas em
  // ProjectTask, chamados via ticketsListId da empresa). Quando preenchido,
  // vira "vitrine" da lista do ClickUp + suporta tarefas ClickUp no projeto.
  clickupListId   String?
  name            String
  description     String?  @db.Text
  type            String? // "SITE" | "MIDIA" | "CAMPANHA" | etc.
  clientCompanyId String?
  clientCompany   Company? @relation("SetorClickupListClient", fields: [clientCompanyId], references: [id], onDelete: SetNull)

  // Serviço do catálogo que este projeto entrega. Ao vincular, o projeto passa a
  // representar o serviço contratado do cliente (sem cadastrar em 2 lugares).
  service   Service? @relation("ServiceProjects", fields: [serviceId], references: [id], onDelete: SetNull)
  serviceId String?

  // Gestão de projeto
  status      ProjectStatus @default(PLANEJAMENTO)
  startDate   DateTime?
  dueDate     DateTime?
  deliveredAt DateTime?

  // Visibilidade: "OPEN" (toda a empresa vê) | "RESTRICTED" (só setor do projeto
  // + membros + pessoas extras em accessUsers). ADMIN/SUPER_ADMIN sempre veem.
  visibility String @default("OPEN")

  // Link público do cliente (consultivo/entrega) — servido em /c/[publicToken],
  // sem login (mesmo padrão do d/[token]). null enquanto não gerado.
  publicToken String? @unique

  // Cache de sync vindo do ClickUp via cron
  taskCount      Int       @default(0)
  taskCompleted  Int       @default(0)
  taskOverdue    Int       @default(0)
  taskNoDueDate  Int       @default(0) // tarefas sem due_date
  taskNoAssignee Int       @default(0) // tarefas sem responsável
  lastSyncedAt   DateTime?

  // Acompanhamento de cobrança ao cliente (quando AGUARDANDO_CLIENTE)
  clientExpectedAt    DateTime? // próxima vez que se espera retorno
  clientLastContactAt DateTime? // última cobrança registrada

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       ProjectMember[]
  taskStates    ProjectTaskState[]
  activities    ProjectActivity[]
  tickets       Ticket[]            @relation("TicketProjeto")
  internalTasks ProjectTask[]
  accessUsers   ProjectAccessUser[]
  materials     ProjectMaterial[]
  serviceSteps  ProjectService[]    @relation("ProjectServicesList") // serviços entregues neste projeto, em sequência

  @@unique([setorId, clickupListId])
  @@index([setorId])
  @@index([clientCompanyId])
  @@index([status])
  @@index([dueDate])
}

// Tarefa NATIVA do LeadHub dentro de um projeto — não vive no ClickUp.
// É o que permite usar Projetos sem depender do ClickUp. Tarefas que devem
// ir pro ClickUp NÃO usam este modelo: são criadas direto na lista do projeto
// e aparecem via ProjectTaskState (snapshot do sync).
model ProjectTask {
  id               String           @id @default(cuid())
  projectId        String
  project          SetorClickupList @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  description      String?          @db.Text
  stage            String? // etapa/fase (rótulo livre, ex.: "Diagnóstico") — fallback quando não há serviço vinculado
  // Serviço (etapa da sequência) ao qual a tarefa pertence. Quando preenchido, o
  // Gantt do cliente agrupa a tarefa sob este serviço, na ordem definida no projeto.
  projectService   ProjectService?  @relation(fields: [projectServiceId], references: [id], onDelete: SetNull)
  projectServiceId String?
  checklist        Json? // sub-passos leves: [{ "text": string, "done": bool }] — micro-progresso dentro da tarefa
  comments         Json? // atualizações/comentários datados: [{ "text": string, "at": ISO }] — o cliente vê o andamento
  clickupTaskId    String? // vínculo com a tarefa do ClickUp (importada) — base pro sync futuro
  awaitingClient   Boolean          @default(false) // aguardando resposta/retorno do cliente (aparece em "Precisa da sua atenção")
  // Controla se a tarefa aparece pro cliente no painel (/c/[token] e /meu-espaco).
  // default true = tarefa nativa criada no LeadHub aparece. Tarefas espelhadas do
  // ClickUp entram com false (ocultas) até você optar por "mostrar pro cliente".
  visibleToClient  Boolean          @default(true)
  done             Boolean          @default(false)
  priority         TicketPriority   @default(MEDIUM)
  startDate        DateTime? // início — pro cliente acompanhar o cronograma
  dueDate          DateTime? // fim / prazo

  assignee   User?   @relation("ProjectTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId String?

  createdBy   User?   @relation("ProjectTaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  materials ProjectMaterial[]

  @@index([projectId, done])
  @@index([assigneeId])
  @@index([projectServiceId])
}

// Serviço do catálogo entregue dentro de um projeto, com posição na sequência.
// Um projeto pode empacotar vários (ex.: 01 Diagnóstico → 02 Planejamento → 03 Execução).
// serviceId é opcional: permite uma etapa livre (só rótulo) sem serviço do catálogo.
model ProjectService {
  id              String           @id @default(cuid())
  projectId       String
  project         SetorClickupList @relation("ProjectServicesList", fields: [projectId], references: [id], onDelete: Cascade)
  serviceId       String?
  service         Service?         @relation("ServiceProjectLinks", fields: [serviceId], references: [id], onDelete: SetNull)
  name            String? // rótulo opcional — sobrescreve o nome do serviço, ou nomeia uma etapa livre
  order           Int              @default(0)
  visibleToClient Boolean          @default(true) // false = serviço inteiro some do painel do cliente
  createdAt       DateTime         @default(now())

  tasks ProjectTask[]

  @@index([projectId])
  @@index([serviceId])
}

// Pessoas extras autorizadas a ver um chamado RESTRICTED (além do setor).
model TicketAccessUser {
  ticketId String
  userId   String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
  @@index([userId])
}

// Pessoas extras autorizadas a ver um projeto RESTRICTED (além do setor/membros).
model ProjectAccessUser {
  projectId String
  userId    String
  project   SetorClickupList @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

// Snapshot do estado das tarefas do ClickUp — usado pra comparar entre syncs
// e detectar criações, atualizações e conclusões.
model ProjectTaskState {
  id            String           @id @default(cuid())
  projectId     String
  project       SetorClickupList @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId        String // ID no ClickUp
  name          String
  statusName    String?
  isCompleted   Boolean          @default(false)
  hasNoAssignee Boolean          @default(false)
  dueDate       BigInt? // epoch ms (vindo do ClickUp; null = sem prazo)
  startDate     BigInt? // epoch ms — data de início do ClickUp (null = sem início)
  dateUpdated   BigInt? // epoch ms
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([projectId, taskId])
  @@index([projectId])
}

// Log de eventos sobre tarefas e cobranças — alimenta o histórico no detail.
model ProjectActivity {
  id          String           @id @default(cuid())
  projectId   String
  project     SetorClickupList @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String // "TASK_CREATED" | "TASK_UPDATED" | "TASK_COMPLETED" | "CLIENT_FOLLOWUP"
  taskName    String // nome da tarefa (ou "Cobrança ao cliente" pra followup)
  taskId      String // ID da task ou string vazia pra followup
  description String?          @db.Text // texto livre (mensagem da cobrança, ex)
  authorId    String?
  authorName  String?
  createdAt   DateTime         @default(now())

  @@index([projectId, createdAt])
}

enum ProjectStatus {
  PLANEJAMENTO
  EM_ANDAMENTO
  AGUARDANDO_CLIENTE // pausa penalidades de prazo (a culpa não é da equipe)
  PAUSADO
  ENTREGUE
  CANCELADO
}

model ProjectMember {
  projectId String
  project   SetorClickupList @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String           @default("MEMBER") // "LEAD" | "MEMBER"
  createdAt DateTime         @default(now())

  @@id([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// Material entregue num projeto (consultivo ou qualquer projeto): documento
// (HTML inline), gravação de reunião (vídeo por URL + ata) ou vídeo de apoio.
// Reaproveita o Projeto (SetorClickupList) — sem subsistema à parte. Sem
// storage de arquivo no LeadHub: doc em HTML @db.Text, vídeo por URL externa.
model ProjectMaterial {
  id              String           @id @default(cuid())
  projectId       String
  project         SetorClickupList @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Opcional: material preso a uma TAREFA específica do projeto. null = material
  // solto no nível do projeto. Um projeto tem N tarefas, cada tarefa N materiais.
  taskId          String?
  task            ProjectTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  kind            String // "DOCUMENTO" | "REUNIAO" | "APOIO" | "LINK" | "ANEXO" | "INLINE"
  stage           String? // rótulo opcional da etapa (ex.: "Diagnóstico")
  title           String
  docHtml         String?          @db.Text // DOCUMENTO: HTML inline
  url             String? // link externo — vídeo, arquivo/anexo ou doc (YouTube/Vimeo/Drive)
  ata             String?          @db.Text // resumo/ata (reuniões)
  // Imagem/print embutido (kind INLINE ou ANEXO): binário em base64 + MIME.
  // Mesmo padrão de TicketMessage.mediaBase64 — servido por endpoint dedicado
  // (/materiais/[id]/media), NUNCA carregado inline em listas (evita OOM).
  // No descritivo da tarefa a imagem é referenciada por um token [[img:<id>]].
  mediaBase64     String?          @db.Text
  mediaType       String? // MIME: "image/png", "image/jpeg"…
  featured        Boolean          @default(false) // material principal — aparece em "Destaques" no topo do painel do cliente
  visibleToClient Boolean          @default(true) // false = material some do painel do cliente (fica só interno)
  order           Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([projectId])
  @@index([taskId])
}

// Pivot: usuário ↔ setor (N:N — um usuário pode pertencer a vários setores)
model SetorUser {
  setorId String
  userId  String

  setor Setor @relation(fields: [setorId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([setorId, userId])
}

// Pivot: setor ↔ instância WhatsApp (N:N)
model SetorInstance {
  setorId    String
  instanceId String

  setor    Setor            @relation(fields: [setorId], references: [id], onDelete: Cascade)
  instance WhatsappInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@id([setorId, instanceId])
}

// ─── Cofre de credenciais ─────────────────────────────────────────────────────
//
// CompanyAsset é qualquer "recurso digital" que gerenciamos para o cliente:
// domínio, hospedagem, site, conta de e-mail, banco, repositório, etc.
// CompanyCredential guarda usuário+senha (criptografada) vinculados a um asset.
// CredentialAccessLog audita quem visualizou cada credencial.

model CompanyAsset {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type       AssetType
  name       String
  url        String?
  host       String? // ex: "ftp.cliente.com.br", "mysql.cliente.com.br:3306"
  identifier String? // ex: nome do domínio "cliente.com.br", e-mail "vendas@x"
  provider   String? // ex: "Hostinger", "Cloudflare", "Google Workspace"
  status     AssetStatus @default(ACTIVE)
  expiresAt  DateTime? // renovação de domínio, validade de SSL, etc.
  notes      String?     @db.Text
  tags       String[]    @default([])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  credentials CompanyCredential[]

  @@index([companyId, type])
  @@index([companyId, expiresAt])
}

enum AssetType {
  DOMAIN
  HOSTING
  WEBSITE
  EMAIL_ACCOUNT
  DATABASE
  DNS_PROVIDER
  REPOSITORY
  SOCIAL_ACCOUNT
  ANALYTICS
  CLOUD_SERVICE
  OTHER
}

enum AssetStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  ARCHIVED
}

model CompanyCredential {
  id      String       @id @default(cuid())
  assetId String
  asset   CompanyAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  label             String // ex: "Admin WordPress", "FTP root", "cPanel"
  username          String?
  // Segredo criptografado (AES-256-GCM). Nunca armazenado em texto claro.
  // Formato no banco: base64(iv|authTag|ciphertext)
  passwordEncrypted String?
  url               String? // link de login direto
  totpSecret        String? // (opcional, criptografado tb) — backlog Fase 2
  notes             String? @db.Text

  lastRotatedAt    DateTime? // alerta para trocar senhas a cada N meses
  sharedWithClient Boolean   @default(false) // já foi compartilhada com o cliente?
  sharedAt         DateTime?

  // Soft-delete (arquivamento). CLIENT não apaga credencial — arquiva.
  // Admin/SUPER_ADMIN veem arquivadas, podem restaurar ou apagar de vez.
  archivedAt     DateTime?
  archivedById   String?
  archivedByName String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  accessLogs CredentialAccessLog[]

  @@index([assetId])
  @@index([assetId, archivedAt])
}

model CredentialAccessLog {
  id           String            @id @default(cuid())
  credentialId String
  credential   CompanyCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  // Denormalizado: facilita filtro "tudo que fulano viu na empresa X"
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId    String?
  userName  String? // snapshot (caso o user seja deletado)
  userRole  String?
  action    CredentialAction
  ipAddress String?
  userAgent String?
  createdAt DateTime         @default(now())

  @@index([credentialId, createdAt])
  @@index([companyId, createdAt])
}

enum CredentialAction {
  REVEAL // visualizou a senha
  COPY // copiou para o clipboard
  SHARE // compartilhou com o cliente (WhatsApp/email)
  EDIT // editou o registro
  CREATE
  DELETE
  ARCHIVE // arquivou (soft-delete por CLIENT)
  RESTORE // admin restaurou um registro arquivado
}

// ─── Cofre: Notas Seguras ─────────────────────────────────────────────────────
//
// CompanySecureNote guarda um bloco de texto grande criptografado (AES-256-GCM),
// autônomo (não vinculado a um asset) — ex: códigos de recuperação, instruções
// de acesso, configurações sensíveis. O `title` fica em texto puro (aparece na
// listagem); o `contentEncrypted` só é decriptado via /reveal, que exige a mesma
// VaultTrustedSession (2FA por e-mail) das credenciais. SecureNoteAccessLog
// audita cada visualização, reaproveitando o enum CredentialAction.

model CompanySecureNote {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title            String
  // Conteúdo criptografado (AES-256-GCM). Formato: base64(iv|authTag|ciphertext).
  // Nunca armazenado em texto claro; nunca enviado na listagem.
  contentEncrypted String @db.Text

  // Soft-delete (arquivamento). CLIENT não apaga — arquiva.
  archivedAt     DateTime?
  archivedById   String?
  archivedByName String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  accessLogs SecureNoteAccessLog[]

  @@index([companyId, archivedAt])
}

model SecureNoteAccessLog {
  id     String            @id @default(cuid())
  noteId String
  note   CompanySecureNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  // Denormalizado: facilita filtro "tudo que fulano viu na empresa X"
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId    String?
  userName  String? // snapshot (caso o user seja deletado)
  userRole  String?
  action    CredentialAction
  ipAddress String?
  userAgent String?
  createdAt DateTime         @default(now())

  @@index([noteId, createdAt])
  @@index([companyId, createdAt])
}

// ─── Integrações de Marketing ─────────────────────────────────────────────────
//
// MarketingIntegration: 1 conexão OAuth do cliente com um provedor (GA4, SC, GBP, Ads).
// Tokens são gravados criptografados (AES-256-GCM via src/lib/crypto.ts).
//
// Fontes de dados são puxadas via cron diário e gravadas em tabelas resumidas:
// AnalyticsSnapshot (1 linha/dia/empresa) — KPIs gerais
// AnalyticsTopPage / TrafficSource / GeoData — quebras dimensionais por dia
// SearchConsoleQuery — top queries por dia

model MarketingIntegration {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  provider     IntegrationProvider
  // Conta/propriedade conectada (ex: "properties/123456" pra GA4, "sc-domain:x.com" pra SC)
  accountId    String?
  accountLabel String? // nome amigável (ex: "azz.com.br")

  // OAuth tokens (criptografados)
  accessTokenEnc  String?   @db.Text
  refreshTokenEnc String?   @db.Text
  tokenExpiresAt  DateTime?
  scopes          String[]  @default([])

  // Identidade do usuário Google que autorizou
  googleEmail String?
  googleName  String?

  status         IntegrationStatus @default(ACTIVE)
  lastSyncAt     DateTime?
  lastSyncStatus String? // "ok" | "error: ..."
  lastError      String?           @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@unique([companyId, provider, accountId])
  @@index([companyId])
  @@index([status, lastSyncAt])
}

enum IntegrationProvider {
  GA4 // Google Analytics 4
  SEARCH_CONSOLE // Google Search Console
  BUSINESS_PROFILE // Google Meu Negócio (GBP)
  GOOGLE_ADS
  META_ADS
}

enum IntegrationStatus {
  ACTIVE
  EXPIRED // refresh token inválido / revogado
  ERROR // falha repetida no sync
  DISCONNECTED // usuário desconectou manualmente
}

// ─── Meta Conversions API (CAPI) — conversões offline do CRM ────────────────────
//
// Quando um lead entra numa etapa marcada como GANHO (PipelineStageConfig.outcome),
// o servidor manda um evento server-to-server pro Pixel do Meta (Graph API
// /{pixelId}/events) pra otimizar campanhas por VENDA REAL, não só formulário.
// Cada empresa-cliente conecta o próprio Pixel + token CAPI (System User).
// O token fica em AES-256-GCM (mesmo padrão do cofre / crypto.ts).
model MetaConversionConfig {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String  @unique

  pixelId        String // ID do Pixel/Dataset no Events Manager
  accessTokenEnc String  @db.Text // token CAPI cifrado (nunca retornado ao cliente)
  testEventCode  String? // TEST#### do Events Manager (vazio em produção)
  eventName      String  @default("Purchase") // evento padrão disparado no ganho
  currency       String  @default("BRL")
  enabled        Boolean @default(true)

  // Diagnóstico do último disparo (mostrado na tela de config).
  lastEventAt DateTime?
  lastStatus  String?   @db.Text // "ok" | "error: ..."

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Outbox/log de cada evento CAPI (Fase 3). Grava PENDING antes de enviar; um
// cron reprocessa PENDING/FAILED com backoff. Idempotente por (companyId,eventId)
// — o mesmo ganho/promoção nunca vira 2 envios. Alimenta a tela de diagnóstico.
model MetaConversionLog {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  leadId    String? // null em evento de teste
  eventName String // "Purchase" | "Lead"
  eventId   String // dedup no Meta: `${lead.id}:won` | `${lead.id}:lead`

  status   MetaConversionStatus @default(PENDING)
  attempts Int                  @default(0)

  value        Float?
  currency     String  @default("BRL")
  matchQuality String? // "website" (com fbc/fbp) | "system_generated"

  eventsReceived Int?
  fbtraceId      String?
  lastError      String?   @db.Text
  nextRetryAt    DateTime? // quando o cron deve tentar de novo (null = não reagendado)
  sentAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, eventId])
  @@index([status, nextRetryAt])
  @@index([companyId, createdAt])
}

enum MetaConversionStatus {
  PENDING
  SENT
  FAILED
}

// ─── Instagram — Automação estilo ManyChat ─────────────────────────────────────
//
// Conexão via "API com Login do Instagram" (fluxo novo da Meta, sem Página do
// Facebook). Diferente de MarketingIntegration (dados organicos via Windsor),
// aqui guardamos a conta para AÇÃO: responder comentários e mandar DM.
//
// Fluxo do módulo:
//   1. Empresa conecta a conta IG → InstagramAccount (token longo 60d cifrado).
//   2. Webhook (/api/webhook/instagram) recebe `comments` e `messages`.
//   3. IgAutomation casa comentário↔regra por palavra-chave no post escolhido.
//   4. Ações: responde o comentário publicamente + manda DM (private reply).
//   5. Follow-gate opcional: só libera o link depois de confirmar follow
//      (is_user_follow_business no contexto de DM — best-effort, igual ManyChat).
//   6. Cada disparo vira IgAutomationRun (idempotência + métricas).

model InstagramAccount {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // ID numérico da conta IG (do token / GET /me). Chave que casa o webhook
  // (entry[].id) de volta com a empresa dona da conta.
  // id do /me (user_id). NEM SEMPRE é o mesmo que o webhook usa em entry.id —
  // o Instagram tem 2 namespaces. Por isso guardamos os dois e casamos por
  // qualquer um (ver findAccountByWebhookId).
  igUserId          String  @unique
  // id app-scoped que o webhook envia em entry.id (campo `id` do /me).
  igScopedId        String?
  username          String?
  name              String?
  profilePictureUrl String? @db.Text

  // Token de longa duração (60 dias) cifrado (AES-256-GCM) + validade para o
  // cron renovar antes de expirar (ig_refresh_token).
  accessTokenEnc String?   @db.Text
  tokenExpiresAt DateTime?
  scopes         String[]  @default([])

  status    IntegrationStatus @default(ACTIVE)
  lastError String?           @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  automations   IgAutomation[]
  runs          IgAutomationRun[]
  conversations IgConversation[]

  @@index([companyId])
  @@index([status, tokenExpiresAt])
  @@index([igScopedId])
}

model IgAutomation {
  id        String           @id @default(cuid())
  companyId String
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId String
  account   InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name    String
  enabled Boolean @default(true)

  // Post-alvo: null = qualquer post da conta; senão o media id do IG.
  mediaId    String?
  mediaLabel String? // legenda curta / thumb pra UI

  // Gatilho por comentário
  triggerType IgTriggerType @default(KEYWORD)
  // Palavras-chave (lower-case). Vazio + triggerType=ANY = qualquer comentário.
  keywords    String[]      @default([])

  // Ação 1: resposta pública ao comentário
  replyToComment Boolean  @default(true)
  // Lista de respostas — escolhe uma aleatória pra não parecer robô.
  commentReplies String[] @default([])

  // Ação 2: DM (private reply) ao autor do comentário
  sendDm        Boolean @default(true)
  // No fluxo de BOTÃO (dmButtonLabel preenchido): dmText = mensagem de abertura,
  // dmButtonLabel = rótulo do botão CTA, deliveredText + dmLinkUrl = conteúdo
  // entregue depois do clique (e do follow, se requireFollow).
  // No fluxo simples (sem botão): dmText + dmLinkUrl são enviados direto.
  dmText        String? @db.Text
  dmLinkUrl     String?
  dmButtonLabel String?
  deliveredText String? @db.Text

  // Follow-gate: só libera o link/DM final depois de confirmar o follow.
  requireFollow    Boolean @default(false)
  notFollowingText String? @db.Text // "me segue aqui e responde 'ok' que te mando 🚀"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs IgAutomationRun[]

  @@index([companyId])
  @@index([accountId, enabled])
  @@index([mediaId])
}

model IgAutomationRun {
  id           String           @id @default(cuid())
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId    String
  account      InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  automationId String?
  automation   IgAutomation?    @relation(fields: [automationId], references: [id], onDelete: SetNull)

  // Quem comentou / abriu DM
  igCommenterId String
  username      String?

  // Origem do disparo
  mediaId     String?
  commentId   String?
  commentText String? @db.Text

  status      IgRunStatus   @default(PENDING)
  followState IgFollowState @default(UNKNOWN)
  errorDetail String?       @db.Text

  // Lead criado a partir deste comentário (conversão manual no relatório).
  leadId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Idempotência: no máximo 1 disparo por comentário por automação.
  @@unique([automationId, commentId])
  @@index([companyId])
  @@index([accountId, status])
  @@index([igCommenterId])
}

enum IgTriggerType {
  KEYWORD // comentário contém alguma das palavras-chave
  ANY // qualquer comentário no post dispara
}

enum IgRunStatus {
  PENDING
  COMMENT_REPLIED
  DM_SENT
  AWAITING_FOLLOW // mandou pedido de follow, esperando confirmação
  COMPLETED
  FAILED
  SKIPPED
}

enum IgFollowState {
  UNKNOWN
  NOT_FOLLOWING
  FOLLOWING
}

// ─── Inbox do Instagram (DMs) ─────────────────────────────────────────────────
//
// SEPARADO do WhatsApp (Conversation/Message) de propósito — modelos próprios
// pra não conflitar. Persistimos os DMs recebidos (webhook `messages`) e os
// enviados (automação/agente), com flag de origem (automação vs orgânico).

model IgConversation {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Canal da conversa (multi-canal). connectionId = id da conexão dona:
  // InstagramAccount.id (IG) ou FacebookPage.pageId (Messenger/Facebook).
  channel      InboxChannel @default(INSTAGRAM)
  connectionId String? // chave de match unificada (account IG ou page FB)

  // Relação opcional com a conta IG (só pro canal INSTAGRAM).
  accountId String?
  account   InstagramAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  participantId       String // IGSID / PSID do contato
  participantUsername String?

  lastMessageAt   DateTime?
  lastMessageText String?         @db.Text
  lastDirection   IgMsgDirection?
  // último IN orgânico ainda sem resposta de agente → painel "sem resposta".
  needsReply      Boolean         @default(false)
  hadAutomation   Boolean         @default(false)

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  IgMessage[]

  @@unique([connectionId, participantId])
  @@index([companyId, needsReply])
  @@index([companyId, lastMessageAt])
}

model IgMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   IgConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  companyId      String
  direction      IgMsgDirection
  source         IgMsgSource    @default(ORGANIC)
  text           String?        @db.Text
  mid            String? // id da msg no Instagram (idempotência)
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

enum IgMsgDirection {
  IN
  OUT
}

enum IgMsgSource {
  ORGANIC // contato iniciou / mensagem fora de automação
  AUTOMATION // enviada/recebida no contexto de automação
  AGENT // enviada manualmente pelo atendente na inbox
}

enum InboxChannel {
  INSTAGRAM
  MESSENGER // DM do Messenger (Página do Facebook)
  FACEBOOK // comentário/post da Página do Facebook
}

// Página do Facebook conectada (pra Messenger + Facebook na inbox).
// Conexão via Facebook Login (separada do Instagram Login). Token da página
// (long-lived) cifrado.
model FacebookPage {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  pageId             String   @unique // id da Página no Facebook (= connectionId das conversas)
  name               String?
  pageAccessTokenEnc String?  @db.Text
  scopes             String[] @default([])

  status    IntegrationStatus @default(ACTIVE)
  lastError String?           @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@index([companyId])
}

model AnalyticsSnapshot {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  source    String // "ga4" | "pixel" (futuramente)

  sessions        Int    @default(0)
  users           Int    @default(0)
  newUsers        Int    @default(0)
  pageviews       Int    @default(0)
  conversions     Int    @default(0)
  bounceRate      Float? // 0..1
  avgSessionSec   Float?
  engagedSessions Int?   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, date, source])
  @@index([companyId, date])
}

model AnalyticsTopPage {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  source    String // "ga4"

  pagePath   String
  pageTitle  String?
  views      Int     @default(0)
  users      Int     @default(0)
  avgTimeSec Float?

  @@unique([companyId, date, source, pagePath])
  @@index([companyId, date])
}

model AnalyticsTrafficSource {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  source    String // "ga4"

  // Dados brutos do GA4
  rawSource String // ex: "google", "instagram.com", "chatgpt.com"
  rawMedium String // ex: "organic", "referral", "cpc"

  // Categoria classificada pela nossa lógica (src/lib/traffic-classifier.ts)
  bucket String // "AI" | "ORGANIC_SEARCH" | "PAID_SEARCH" | "INSTAGRAM" | ...

  sessions    Int @default(0)
  users       Int @default(0)
  conversions Int @default(0)

  @@unique([companyId, date, source, rawSource, rawMedium])
  @@index([companyId, date, bucket])
}

model AnalyticsGeoData {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  source    String // "ga4"

  countryCode String? // "BR", "US"
  countryName String?
  region      String? // estado / província
  city        String?

  sessions Int @default(0)
  users    Int @default(0)

  @@unique([companyId, date, source, countryCode, region, city])
  @@index([companyId, date])
}

// Eventos GA4 por dia (padrão como page_view/scroll/click + personalizados).
// Sync diário popula. UI mostra a lista pra cliente marcar quais são conversão (ver MarketingEventConfig).
model AnalyticsEventDaily {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  source    String // "ga4"

  eventName  String
  eventCount Int    @default(0)
  users      Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, date, source, eventName])
  @@index([companyId, date])
  @@index([companyId, eventName])
}

// Config por empresa: quais eventos contam como conversão no LeadHub, rótulo amigável,
// e se devem ser ocultados da lista do dashboard. Independente do que o admin do GA4
// marcou como "key event" — o cliente do LeadHub decide aqui.
model MarketingEventConfig {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source    String // "ga4"
  eventName String

  isConversion Boolean @default(false)
  displayLabel String? // "Lead WhatsApp" / "Formulário enviado" — usado nos cards
  hidden       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, source, eventName])
  @@index([companyId])
}

model SearchConsoleQuery {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date

  query   String
  page    String?
  country String? // "bra"
  device  String? // "MOBILE" | "DESKTOP" | "TABLET"

  clicks      Int
  impressions Int
  ctr         Float // 0..1
  position    Float // posição média

  @@unique([companyId, date, query, page, country, device])
  @@index([companyId, date])
  @@index([companyId, query])
}

// ─── Google Business Profile (GBP / "Meu Negócio") ────────────────────────────
//
// Espelha o padrão do GA4 / Search Console: 1 MarketingIntegration (provider=
// BUSINESS_PROFILE) representa 1 location escolhida. Cron diário roda syncGbp
// que popula as tabelas abaixo. Range padrão 30 dias.
//
// Dados origem (4 APIs):
//   - businessprofileperformance.googleapis.com → insights (views, actions) + keywords
//   - mybusiness.googleapis.com/v4 (legacy)     → reviews
//   - mybusinessbusinessinformation.googleapis.com → profile

// 1 linha/dia/empresa — KPIs operacionais do perfil
model GbpInsight {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  date      DateTime @db.Date

  // Impressões (views do perfil)
  impressionsSearchDesktop Int @default(0)
  impressionsSearchMobile  Int @default(0)
  impressionsMapsDesktop   Int @default(0)
  impressionsMapsMobile    Int @default(0)

  // Ações
  callClicks        Int @default(0)
  websiteClicks     Int @default(0)
  directionRequests Int @default(0)
  conversations     Int @default(0)
  bookings          Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, date])
  @@index([companyId, date])
}

// 1 linha/review — usada em card "últimas reviews" + KPI rating médio
model GbpReview {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  // ID externo do Google (accounts/X/locations/Y/reviews/Z)
  googleReviewId String @unique

  reviewerName     String?
  reviewerPhotoUrl String?
  starRating       Int // 1-5
  comment          String?   @db.Text
  createTime       DateTime
  updateTime       DateTime?

  // Resposta do dono (se houver)
  replyComment    String?   @db.Text
  replyUpdateTime DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, createTime])
  @@index([companyId, starRating])
}

// Termo de busca → impressões mensais (granularidade que a API entrega)
model GbpSearchKeyword {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  keyword     String
  year        Int
  month       Int // 1-12
  impressions Int // pode ser threshold ("<15")
  isThreshold Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([companyId, year, month, keyword])
  @@index([companyId, year, month])
}

// Snapshot do perfil — espelho dos campos + completenessScore calculado
model GbpProfileSnapshot {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  title             String?
  primaryCategory   String?
  storefrontAddress Json?
  primaryPhone      String?
  websiteUri        String?
  regularHours      Json?
  description       String? @db.Text
  photoCount        Int?
  // 0-100 — quanto está preenchido. Card "Profile Health" mostra checks faltando.
  completenessScore Int

  // Agregados vindos do response da API v4 reviews (top-level averageRating +
  // totalReviewCount). Fallback pro card "Avaliação média" quando reviews
  // individuais não vêm pela paginação.
  googleAverageRating Float?
  googleReviewCount   Int?

  syncedAt DateTime @default(now())

  @@index([companyId, syncedAt])
}

// ─── Ads (Google Ads / Meta Ads) — relatório de campanha patrocinada ──────────
//
// Tabela provider-agnóstica: 1 linha por (empresa, provider, dia, campanha).
// Alimenta o Dashboard de Marketing → aba Ads (KPIs, série diária, funil,
// tabela por campanha). Fase 1 = Google Ads (provider=GOOGLE_ADS); Meta Ads
// reaproveita a mesma tabela (provider=META_ADS) na Fase 2.
//
// Origem dos dados:
//   - Google Ads API (GAQL): segments.date + campaign → metrics.cost_micros,
//     clicks, impressions, conversions, conversions_value.
//   - Meta Marketing API (futuro): /{ad-account}/insights level=campaign.
//
// Dinheiro guardado em `cost`/`conversionValue` como Decimal na moeda da conta
// (Google: cost_micros / 1e6). Upsert idempotente — roda várias vezes/dia.
model AdCampaignDaily {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  provider IntegrationProvider // GOOGLE_ADS | META_ADS
  date     DateTime            @db.Date

  externalCampaignId String // id da campanha na plataforma
  campaignName       String
  campaignStatus     String? // ENABLED | PAUSED | REMOVED (rótulo da plataforma)

  impressions     Int     @default(0)
  clicks          Int     @default(0)
  cost            Decimal @default(0) @db.Decimal(14, 2) // gasto na moeda da conta
  conversions     Float   @default(0) // Google entrega frações
  conversionValue Decimal @default(0) @db.Decimal(14, 2) // receita atribuída
  currency        String? // ex: "BRL"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, provider, date, externalCampaignId])
  @@index([companyId, provider, date])
}

// Termo de pesquisa (o que a pessoa digitou) → métricas por dia.
// Origem Google Ads: search_term_view. 1 linha por (empresa, provider, dia,
// termo, ad group). Alta cardinalidade — o sync só grava termos com atividade.
model AdSearchTermDaily {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  provider IntegrationProvider
  date     DateTime            @db.Date

  searchTerm   String
  adGroupId    String  @default("") // chave de unicidade (mesmo termo em ad groups diferentes)
  adGroupName  String?
  campaignName String?

  impressions     Int     @default(0)
  clicks          Int     @default(0)
  cost            Decimal @default(0) @db.Decimal(14, 2)
  conversions     Float   @default(0)
  conversionValue Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, provider, date, searchTerm, adGroupId])
  @@index([companyId, provider, date])
}

// Conteúdo do anúncio (estático) — pra renderizar a "prévia". Upsert por ad.
// Origem Google Ads: ad_group_ad (foco em Responsive Search Ad).
model AdCreative {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  provider     IntegrationProvider
  externalAdId String

  campaignName String?
  adGroupName  String?
  adType       String? // RESPONSIVE_SEARCH_AD, etc.
  status       String?

  headlines    Json? // [{ text, pinnedField }]
  descriptions Json? // [{ text, pinnedField }]
  finalUrl     String?
  path1        String?
  path2        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, provider, externalAdId])
  @@index([companyId, provider])
}

// Métricas diárias por anúncio — pra eleger o "anúncio destaque" no período.
model AdCreativeDaily {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  provider     IntegrationProvider
  date         DateTime            @db.Date
  externalAdId String

  impressions     Int     @default(0)
  clicks          Int     @default(0)
  cost            Decimal @default(0) @db.Decimal(14, 2)
  conversions     Float   @default(0)
  conversionValue Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, provider, date, externalAdId])
  @@index([companyId, provider, date])
}

// ─── Cobrança / Assinaturas ───────────────────────────────────────────────────
//
// Cada Company tem 1 Subscription. Na pivô pra "vender pro cliente final", a
// hierarquia é simplificada: top-level companies (parentCompanyId=null) pagam.
// Sub-companies, se existirem no futuro, herdam plano da pai.
//
// Estados típicos:
//  TRIALING → primeiros 14 dias após signup, sem cartão
//  ACTIVE → assinatura paga e em dia
//  PAST_DUE → pagamento falhou, em período de graça (5 dias)
//  CANCELED → cancelado pelo cliente, ainda ativo até currentPeriodEnd
//  UNPAID → não pagou, acesso bloqueado
//  INCOMPLETE → checkout iniciado mas não finalizado

model Subscription {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  plan         PlanTier           @default(TRIAL)
  status       SubscriptionStatus @default(TRIALING)
  billingCycle String             @default("monthly") // "monthly" | "annual"

  // Trial
  trialEndsAt DateTime?

  // Período corrente (válido pra ACTIVE/CANCELED)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?

  // Stripe
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  // Cache de cartão (last4, brand) só pra mostrar na UI — sem dado sensível
  cardBrand String?
  cardLast4 String?

  // ─── Overrides por cliente (super admin define manualmente) ──────────────
  // Usado principalmente no plano FREE pra liberar limites/features
  // específicos de cada cliente (parceiros, amigos, beta testers, lifetime deals).
  // Quando preenchido, prevalece sobre os defaults do plano.
  // Estrutura esperada (validada no app, não no DB):
  //   customLimits   = { whatsappInstances?:n, atendentes?:n, unidades?:n, leadsPerMonth?:n }
  //   customFeatures = { marketingDashboard?:bool, cofreCredenciais?:bool, ... }
  customLimits   Json?
  customFeatures Json?
  /// Anotação livre só pra você lembrar por que aquele cliente tem override
  customNotes    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([trialEndsAt])
}

enum PlanTier {
  FREE
  TRIAL
  ORGANIZATION
  ESSENCIAL
  MARKETING
  CRESCIMENTO
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
}

// ─── Horário de Atendimento ───────────────────────────────────────────────────
// Configuração por dia da semana. Intervalos (pausas) ficam em BusinessHoursInterval.
// Usado pelo motor de gamificação para calcular tempo de resposta dentro do horário útil.

model BusinessHoursConfig {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0=dom … 6=sáb
  isOpen    Boolean  @default(true)
  openTime  String   @default("09:00") // "HH:MM"
  closeTime String   @default("18:00") // "HH:MM"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  intervals BusinessHoursInterval[]

  @@unique([companyId, dayOfWeek])
  @@index([companyId])
}

model BusinessHoursInterval {
  id        String              @id @default(cuid())
  configId  String
  config    BusinessHoursConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  startTime String // "HH:MM"
  endTime   String // "HH:MM"
  label     String? // "Almoço", "Reunião de equipe", etc.

  @@index([configId])
}

// ─── Sistema de Prêmios ───────────────────────────────────────────────────────
// Catálogo configurável pela empresa: ☕ café (100 pts) → ✈️ viagem (15k pts).
// Resgate debita redeemablePoints, gera RewardRedemption pendente que admin
// aprova/recusa.

model Reward {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  cost        Int
  available   Boolean  @default(true)
  imageUrl    String?
  stock       Int? // null = ilimitado
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  redemptions RewardRedemption[]

  @@index([companyId, available])
}

model RewardRedemption {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rewardId   String
  reward     Reward           @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  rewardName String // snapshot
  cost       Int
  status     RedemptionStatus @default(PENDING)
  notes      String? // admin note (motivo de rejeição, etc.)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  resolvedAt DateTime?

  @@index([userId, createdAt])
  @@index([companyId, status])
}

enum RedemptionStatus {
  PENDING // aguardando aprovação do admin
  APPROVED // aprovado, em trânsito
  DELIVERED // entregue
  REJECTED // recusado (pontos devolvidos)
}

// ─── Gamificação ──────────────────────────────────────────────────────────────
// Pontuação mensal e histórica por usuário. monthPoints reseta no dia 1 de
// cada mês via cron. totalPoints nunca zera (histórico vitalício).

model UserScore {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  totalPoints      Int      @default(0) // histórico vitalício (nunca decrementa via resgate)
  monthPoints      Int      @default(0) // do mês corrente (reseta dia 1)
  redeemablePoints Int      @default(0) // disponíveis pra trocar por prêmios
  month            Int
  year             Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([companyId, month, year])
  @@index([userId])
}

model UserBadge {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  badge     BadgeType
  tier      Int       @default(1) // 1-6, definição em src/app/(admin)/gamificacao/labels.ts
  earnedAt  DateTime  @default(now())

  @@unique([userId, badge, tier])
  @@index([userId])
  @@index([companyId])
}

model ScoreEvent {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  points      Int
  reason      ScoreReason
  referenceId String?
  // Para incidentes manuais (reason=INCIDENTE) e bônus customizados:
  description String?     @db.Text // o que aconteceu / contexto
  authorId    String? // quem registrou
  authorName  String? // snapshot (caso author seja deletado)
  createdAt   DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([companyId, createdAt])
}

// Configuração de regras de pontuação por empresa.
// Override do SCORE_TABLE em src/lib/gamification.ts.
model ScoreRuleConfig {
  id             String      @id @default(cuid())
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reason         ScoreReason
  enabled        Boolean     @default(true)
  points         Int
  // Quando false, o ScoreEvent é criado (badge conta) mas o UserScore NÃO
  // recebe os pontos — útil pra impedir que VENDAS dominem o ranking mensal.
  affectsRanking Boolean     @default(true)
  updatedAt      DateTime    @updatedAt

  @@unique([companyId, reason])
  @@index([companyId])
}

enum BadgeType {
  RAIO_VELOZ // 50 respostas em <5min no mês
  SPRINT_MASTER // 7 dias sem atraso
  PRIMEIRO_DO_DIA // 1a resposta do dia 3x seguidas
  RESOLVEDOR // 20 tickets resolvidos
  ZERO_PENDENCIA // semana sem conversa aberta
  ANTECIPADOR // 10 retornos cumpridos antes do prazo
  CLOSER // 5 conversões de lead no mês
  FUNIL_COMPLETO // lead avançou todas as etapas em <7 dias
  REI_DO_MES // 1o lugar no ranking mensal
  PONTUAL // dias terminados sem nada atrasado
  ENTREGADOR // projetos entregues no prazo
  CONSTRUTOR // tarefas concluídas no ClickUp
  ENGAJADO // tarefas atualizadas no ClickUp
  GERADOR // tarefas criadas no ClickUp
  // Easter eggs — escondidas pra não-admin até desbloquearem
  CORUJA // respostas após o expediente (após 22h, dia útil)
  MADRUGADOR // respostas antes das 7h
  SORTUDO // lead criado e fechado no mesmo dia
  FENIX // lead que estava LOST e voltou pra CLOSED
  // Colaboração / ajuda mútua entre atendentes
  EXERCITO // responde conversa de outro responsável quando cliente espera
  LIDER // encaminha conversa pra colega adequado (muda assignee/setor)
  GUARDIAO // primeiro a responder em conversa nova sem responsável
  // Mestres do Ofício — chamados próprios (gamificação de tickets)
  ALQUIMISTA // atualiza/comenta no próprio chamado (constância)
  SNIPER // resolveu chamado antes do dueDate (precisão)
  TROVAO // chamado criado e resolvido no mesmo dia (velocidade)
  // Atendimento em grupos — clientes que conversam em grupo do WhatsApp
  DIPLOMATA // primeira resposta em grupo novo (variedade de relacionamentos)
  PRECISO // resposta rápida em grupo (≤5min úteis após cliente)
  NETWORK // dia em que respondeu em 3+ grupos diferentes
}

enum ScoreReason {
  RESPOSTA_RAPIDA_5MIN
  RESPOSTA_RAPIDA_30MIN
  TICKET_RESOLVIDO
  LEAD_AVANCADO
  LEAD_CONVERTIDO
  DIA_SEM_PENDENCIA
  DIA_SEM_ATRASO // dia terminado sem dueDate/scheduledReturnAt vencidos
  RETORNO_ANTECIPADO
  ATENDIMENTO_MESMO_DIA
  NOTA_REGISTRADA
  PRIMEIRO_CONTATO // triagem / "estamos encaminhando" em conversa de outro
  PROJETO_ENTREGUE // projeto marcado como ENTREGUE
  PROJETO_ENTREGUE_NO_PRAZO // bônus quando deliveredAt <= dueDate
  SLA_VENCIDO
  CONVERSA_SEM_RESPOSTA
  PRAZO_PRORROGADO // empurrar prazo depois de já vencido
  PROJETO_ATRASADO // projeto entregue depois do dueDate
  TAREFA_SEM_PRAZO // tarefas no ClickUp sem due_date (cron diário)
  TAREFA_CRIADA // tarefa criada no ClickUp (sync)
  TAREFA_ATUALIZADA // tarefa atualizada no ClickUp (sync)
  TAREFA_CONCLUIDA // tarefa concluída no ClickUp (sync)
  TAREFA_ATRASADA // tarefa overdue no ClickUp (cron diário)
  TAREFA_SEM_RESPONSAVEL // tarefa sem assignee no ClickUp (cron diário)
  STREAK_DIA // dia consecutivo sem atraso (alimenta SPRINT_MASTER)
  BONUS_NOITE // mensagem fora do horário comercial (Coruja)
  BONUS_MADRUGADA // mensagem antes das 7h (Madrugador)
  BONUS_VENDA_RAPIDA // lead criado e fechado mesmo dia (Sortudo)
  BONUS_RECUPERACAO // lead LOST → CLOSED (Fênix)
  BONUS_SUPEROU_MES // mês corrente > mês anterior em pontos
  INCIDENTE // penalidade manual registrada por admin (ex: descuido com cliente)
  AJUDA_EXERCITO // respondeu cliente em conversa de outro responsável (Exército)
  ENCAMINHAMENTO // encaminhou conversa pra colega adequado (Líder)
  PRIMEIRA_RESPOSTA // primeiro a responder em conversa sem responsável (Guardião)
  TICKET_ATUALIZADO // atualização/comentário no próprio chamado (Alquimista)
  TICKET_NO_PRAZO // chamado resolvido antes do dueDate (Sniper)
  TICKET_RESOLVIDO_MESMO_DIA // chamado criado e resolvido no mesmo dia (Trovão)
  ATENDIMENTO_GRUPO_NOVO // primeira resposta num grupo novo (Diplomata)
  RESPOSTA_RAPIDA_GRUPO // resposta em grupo em ≤5min úteis (Preciso)
  DIA_NETWORK // dia em que respondeu em 3+ grupos diferentes (Network)
  LEAD_VIROU_OPORTUNIDADE // lead promovido pra oportunidade (cliente pediu orcamento)
  TAREFA_LEADHUB_FEITA // marcou tarefa do LeadHub como feita (não confundir com TAREFA_CONCLUIDA do ClickUp)
  SINAL_QUENTE_RESPONDIDO // marcou tarefa AUTO_LINK_OPEN feita (cliente abriu proposta → vendedor agiu rápido)
}

// ─── Push Notifications (Web Push API) ───────────────────────────────────────
// Cada navegador/device do usuário tem uma PushSubscription. Quando o usuário
// permite notificações, o frontend envia o objeto subscription pra cá. Os hooks
// do servidor (mensagem nova, sinal quente etc.) percorrem todas as subs ativas
// do destinatário e disparam.

model PushSubscription {
  id        String  @id @default(cuid())
  endpoint  String  @unique // URL única do push service do browser
  p256dh    String // chave pública (criptografia VAPID)
  auth      String // segredo compartilhado
  userAgent String? // pra UI mostrar "Chrome no Mac" etc.

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Quando uma notificação retorna 410 Gone, a sub é apagada.
  lastFailedAt DateTime?
  failCount    Int       @default(0)

  createdAt DateTime @default(now())

  @@index([userId])
}

model UserNotifPreferences {
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  // Liga/desliga categorias específicas
  newMessage  Boolean @default(true) // chegou mensagem WhatsApp em conversa que é minha
  hotSignal   Boolean @default(true) // tarefa AUTO_LINK_OPEN criada
  taskOverdue Boolean @default(false) // ainda não tem cron, deixa off
  followUp    Boolean @default(true) // resumo diário: leads/oportunidades pra retornar + esfriando

  updatedAt DateTime @updatedAt
}

// ─── Email Marketing (módulo moduleEmailMarketing) ───────────────────────────
// Cada empresa-cliente com o módulo ligado configura o próprio SMTP e dispara
// campanhas pros leads. Worker (pg-boss) processa com cadência. Tracking de
// abertura/clique + compliance LGPD (unsubscribe + suppression list).

// SMTP próprio da empresa (separado do SMTP global do sistema, que fica em Setting).
model CompanyEmailConfig {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String  @unique

  host      String
  port      Int     @default(465)
  secure    Boolean @default(true)
  user      String
  // Senha em AES-256-GCM (mesmo formato do cofre / crypto.ts).
  passEnc   String
  fromEmail String // remetente fixo das campanhas
  fromName  String // "Diego — AZZ Agência"
  // Quando preenchido, vai no header Reply-To — cliente que responde
  // o email vai pra este endereço, não pro fromEmail. Útil quando o SMTP
  // exige que From == usuário autenticado mas você quer receber respostas
  // numa caixa diferente.
  replyTo   String?

  // Status da última verificação de conexão
  verified       Boolean   @default(false)
  lastVerifiedAt DateTime?
  lastError      String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailTemplate {
  id      String  @id @default(cuid())
  name    String // "Proposta padrão", "Follow-up 7 dias"
  subject String // pode usar {{nome}}
  html    String  @db.Text // corpo HTML com {{vars}}
  text    String? @db.Text // fallback texto puro (auto-gerado se vazio)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  campaigns EmailCampaign[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([companyId])
}

model EmailCampaign {
  id          String              @id @default(cuid())
  name        String
  subject     String
  template    EmailTemplate       @relation(fields: [templateId], references: [id])
  templateId  String
  status      EmailCampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  // Cadência: { maxPerHour, jitterMs:[min,max], windowStart, windowEnd, daysOfWeek, timezone }
  cadenceConfig Json
  // Segmento (snapshot): { pipeline?, pipelineStage?, tagIds?: string[], hasEmail: true }
  segmentFilter Json

  // Stats (atualizados pelo worker)
  totalRecipients   Int @default(0)
  sentCount         Int @default(0)
  deliveredCount    Int @default(0)
  openedCount       Int @default(0)
  clickedCount      Int @default(0)
  bouncedCount      Int @default(0)
  unsubscribedCount Int @default(0)
  failedCount       Int @default(0)

  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId   String
  createdBy   User?   @relation("EmailCampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  recipients    EmailRecipient[]
  // Leads que foram promovidos (Prospect→Lead etc.) por engajamento com esta campanha.
  promotedLeads Lead[]           @relation("CampaignPromotedLeads")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([companyId, status])
  @@index([scheduledAt])
}

enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  COMPLETED
  FAILED
}

model EmailRecipient {
  id         String        @id @default(cuid())
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  lead       Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId     String?
  email      String // snapshot no momento de criação
  name       String?
  vars       Json? // variáveis renderizadas { nome, empresa, valor… }

  status         EmailRecipientStatus @default(PENDING)
  sentAt         DateTime?
  firstOpenedAt  DateTime?
  firstClickedAt DateTime?
  bouncedAt      DateTime?
  errorMessage   String?              @db.Text

  // token curto usado em pixel/click/unsubscribe
  token String @unique @default(cuid())

  events    EmailEvent[]
  createdAt DateTime     @default(now())
  // @default(now()) garante que linhas existentes recebam um valor quando
  // a coluna for adicionada via `db push` (sem isso, Prisma não consegue
  // adicionar a coluna NOT NULL e pula silenciosamente).
  updatedAt DateTime     @default(now()) @updatedAt

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([status, updatedAt]) // pra resetar SENDING travado
  @@index([token])
}

enum EmailRecipientStatus {
  PENDING
  SENDING
  SENT
  BOUNCED
  FAILED
  SKIPPED
}

model EmailEvent {
  id          String         @id @default(cuid())
  recipient   EmailRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String
  type        EmailEventType
  targetUrl   String?        @db.Text
  ipAddress   String?
  userAgent   String?        @db.Text
  createdAt   DateTime       @default(now())

  @@index([recipientId, type])
  @@index([type, createdAt])
}

enum EmailEventType {
  OPEN
  CLICK
  BOUNCE
  COMPLAINT
  UNSUBSCRIBE
}

model EmailUnsubscribe {
  id        String   @id @default(cuid())
  email     String // normalizado (lowercase)
  reason    String?
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  createdAt DateTime @default(now())

  @@unique([email, companyId])
  @@index([email])
}

// ─── Caixa de Email (grupo Atender · usa moduleEmailMarketing) ───────────────
// Caixa de entrada/saída de email operacional da empresa. Cada empresa pode
// cadastrar VÁRIAS contas (comercial@, suporte@…), cada uma com as próprias
// credenciais de envio (SMTP) e recebimento (IMAP). Poller em
// /api/cron/imap-sync. Triagem manual: importante / spam / lixeira.

// Conta de email da empresa — SMTP (envio) + IMAP (recebimento) juntos.
model EmailAccount {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  label     String? // apelido na UI: "Comercial", "Suporte"
  fromName  String // "Diego — AZZ Agência"
  fromEmail String // remetente exibido nos envios

  // Envio (SMTP). Senhas em AES-256-GCM (crypto.ts). NUNCA saem pela API.
  smtpHost    String
  smtpPort    Int     @default(465)
  smtpSecure  Boolean @default(true)
  smtpUser    String
  smtpPassEnc String

  // Recebimento (IMAP). Opcional — conta pode ser só de envio.
  imapHost    String?
  imapPort    Int     @default(993)
  imapSecure  Boolean @default(true)
  imapUser    String?
  imapPassEnc String?

  // Liga/desliga o poller/envio sem apagar a conta.
  active Boolean @default(true)

  // Estado da sincronização incremental: último UID importado da INBOX +
  // uidValidity da mailbox (se o servidor resetar a validade, recomeça).
  lastUid      Int?
  uidValidity  BigInt?
  lastSyncedAt DateTime?

  // Cursor separado da pasta de Enviados do servidor (\Sent) — pega emails
  // mandados por fora da plataforma (webmail, celular).
  sentLastUid     Int?
  sentUidValidity BigInt?

  // Status da última verificação/sync
  smtpVerified   Boolean   @default(false)
  imapVerified   Boolean   @default(false)
  lastVerifiedAt DateTime?
  lastError      String?   @db.Text

  emails InboxEmail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// Um email da caixa (recebido via IMAP ou enviado pela plataforma).
model InboxEmail {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  // Conta pela qual o email entrou/saiu. SetNull: apagar a conta não apaga
  // o histórico de emails.
  account   EmailAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId String?

  direction InboxEmailDirection
  folder    InboxEmailFolder    @default(INBOX)

  // Message-ID do header (dedup no re-sync). Nulo em servidores que não enviam.
  messageId String?
  // UID IMAP de origem (só em recebidos).
  imapUid   Int?

  fromEmail String
  fromName  String?
  toEmail   String // destinatários To separados por vírgula
  subject   String  @default("")
  snippet   String  @default("") // primeiros ~180 chars do texto, pra lista
  textBody  String? @db.Text
  htmlBody  String? @db.Text

  // In-Reply-To do header — encadeia resposta enviada ao email original.
  inReplyTo String?

  // Vínculo com CRM/atendimento: email enviado de dentro de um lead
  // (Prospecção/Leads/Oportunidades) ou chamado sai com o vínculo; resposta
  // recebida herda o vínculo via In-Reply-To ou pelo email do remetente.
  lead     Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId   String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  ticketId String?

  // Triagem IA (endpoint /api/email/inbox/ai-triage, cota do Assistente IA):
  // importância "ALTA" | "NORMAL" | "BAIXA" + resumo de 1 linha.
  aiImportance String?
  aiSummary    String? @db.Text

  // Tags livres da empresa (classificação manual, m2m implícito).
  tags InboxEmailTag[] @relation("InboxEmailTags")

  attachments InboxEmailAttachment[]

  seen   Boolean  @default(false)
  sentAt DateTime // data do header Date (recebidos) ou do envio (enviados)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Dedup por conta: o mesmo Message-ID pode chegar em duas contas da empresa
  // (email enviado pra comercial@ e suporte@ ao mesmo tempo).
  @@unique([accountId, messageId])
  @@index([companyId, folder, sentAt])
  @@index([companyId, seen])
  @@index([leadId])
  @@index([ticketId])
}

// Regra por remetente (blacklist/whitelist):
//   BLOCK — próximos emails do remetente caem direto na pasta SPAM. Criada
//           automaticamente ao marcar um email como spam (removida ao restaurar)
//           ou manualmente na tela de regras.
//   ALLOW — remetente confiável: nunca cai no spam automático.
// Uma regra por remetente (o tipo define o comportamento).
model InboxSenderRule {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  fromEmail String // normalizado (lowercase)
  type      InboxSenderRuleType @default(BLOCK)

  createdAt DateTime @default(now())

  @@unique([companyId, fromEmail])
}

enum InboxSenderRuleType {
  BLOCK
  ALLOW
}

// Anexo de email — SÓ METADADOS (nome, tipo, tamanho e a parte MIME dentro
// da mensagem). O conteúdo NÃO fica no banco: ao clicar no link, a rota
// /api/email/inbox/attachments/[id] baixa a parte direto do servidor IMAP
// sob demanda. Zero peso de storage; requer o email ainda existir no servidor.
model InboxEmailAttachment {
  id      String     @id @default(cuid())
  email   InboxEmail @relation(fields: [emailId], references: [id], onDelete: Cascade)
  emailId String

  filename    String
  contentType String @default("application/octet-stream")
  size        Int    @default(0) // bytes (aprox., como reportado na estrutura MIME)
  // Identificador da parte MIME na mensagem (ex: "2", "1.2") — usado no
  // download IMAP (client.download(uid, partId)).
  partId      String

  createdAt DateTime @default(now())

  @@index([emailId])
}

// Tag de email da empresa — classificação manual da caixa ("Financeiro",
// "Fornecedor", "Urgente"...). Aplicada por email (m2m) e usada como filtro.
model InboxEmailTag {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  name  String
  color String @default("#6366f1") // hex da etiqueta na UI

  emails InboxEmail[] @relation("InboxEmailTags")

  createdAt DateTime @default(now())

  @@unique([companyId, name])
}

enum InboxEmailDirection {
  IN
  OUT
}

enum InboxEmailFolder {
  INBOX
  IMPORTANT
  SENT
  ARCHIVE // "Resolvidos" — tratado/ok, arquivado sem descartar
  SPAM
  TRASH
}

// Trilha de auditoria de eventos de cobrança — útil pra suporte e debug.
model BillingEvent {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type     String // "trial_started" | "subscribed" | "upgraded" | "downgraded" | "canceled" | "payment_succeeded" | "payment_failed" | "trial_ended"
  fromPlan String?
  toPlan   String?
  amount   Float? // BRL
  metadata Json?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

// ─── Add-ons de assinatura ────────────────────────────────────────────────────
// Recursos extras cobrados por unidade além do plano base:
//  - EXTRA_ATENDENTE  → +1 atendente (R$ 19,90/un)
//  - EXTRA_WHATSAPP   → +1 número WhatsApp (R$ 99/un)
// checkLimit() soma a quantidade contratada ao limite base do plano.
model SubscriptionAddon {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type      AddonType
  quantity  Int       @default(1)
  unitPrice Float // BRL — snapshot do preço na contratação (não muda se a tabela mudar)

  // Stripe (quando integrado) — subscription item que representa este add-on
  stripeItemId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, type])
  @@index([companyId])
}

enum AddonType {
  EXTRA_ATENDENTE
  EXTRA_WHATSAPP
}

// ─── Cupons promocionais ──────────────────────────────────────────────────────
// Criados pelo SUPER_ADMIN. Aplicados no checkout pra descontar % ou valor fixo.
model Coupon {
  id    String  @id @default(cuid())
  code  String  @unique // ex: "LANCAMENTO50" (case-insensitive na aplicação)
  label String? // descrição interna

  discountType  CouponDiscountType
  discountValue Float // percent (0-100) OU valor fixo em BRL, conforme discountType

  // Recorrência do desconto:
  //  false (padrão) → desconto só no 1º pagamento
  //  true           → desconto em todas as cobranças enquanto a assinatura viver
  recurring Boolean @default(false)

  // Restrições opcionais
  validFrom      DateTime?
  validUntil     DateTime?
  maxUses        Int? // null = ilimitado
  usedCount      Int       @default(0)
  // Restringe a planos específicos (vazio = qualquer plano)
  appliesToPlans String[]  @default([])

  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  redemptions CouponRedemption[]

  @@index([active])
}

enum CouponDiscountType {
  PERCENT
  FIXED
}

model CouponRedemption {
  id        String  @id @default(cuid())
  couponId  String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  appliedAt   DateTime @default(now())
  planAtApply String? // snapshot do plano no momento da aplicação
  amountOff   Float? // quanto foi descontado (BRL) — auditoria

  @@unique([couponId, companyId])
  @@index([companyId])
}

// ─── Auditoria administrativa ─────────────────────────────────────────────────
// Trilha de ações sensíveis executadas por SUPER_ADMIN/ADMIN (impersonation,
// override de plano, alterações em outras empresas, etc.).
// Exigência B2B/LGPD: cliente precisa saber quando alguém da Lazzari logou
// como ele e o que foi feito.
//
// Estrutura propositalmente solta (sem FK para User/Company) pra não bloquear
// retenção: queremos manter o log mesmo se o usuário/empresa for excluído.
model AdminAuditLog {
  id String @id @default(cuid())

  adminUserId    String // quem executou (SUPER_ADMIN ou ADMIN)
  adminUserName  String?
  adminUserEmail String?

  action          String // "IMPERSONATE_START" | "IMPERSONATE_END" | "PLAN_OVERRIDE" | "MODULE_TOGGLE" | etc.
  targetCompanyId String? // empresa-alvo (null se ação não é em empresa específica)
  targetUserId    String? // usuário-alvo (ex.: reset de senha)

  ip        String?
  userAgent String? @db.Text
  metadata  Json? // payload extra: motivo, valores antes/depois, etc.

  createdAt DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([targetCompanyId, createdAt])
  @@index([action, createdAt])
}

// ─── Assistentes de IA (configuráveis por empresa) ────────────────────────────
// Cada Assistant é um "agente" com comportamento próprio definido por um manual
// editável (system prompt). O `type` define o papel; a UI/lógica usa o agente
// ATIVO de cada tipo. `instanceId` (opcional) vincula o agente a uma instância
// WhatsApp específica (ex.: número de vendas → agente VENDAS). A key da OpenAI é
// global; o consumo é controlado pela cota mensal da Company (ver aiMonthlyQuota).
model Assistant {
  id        String        @id @default(cuid())
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  name      String // nome amigável ("Closer de Vendas", "Suporte Financeiro")
  type      AssistantType
  // Manual de instruções = system prompt. Como agir, tom, objetivo, o que pode/
  // não pode dizer. É o coração do agente — editado pelo admin da empresa.
  manual    String        @db.Text
  isActive  Boolean       @default(true)

  // Modo AUTÔNOMO: quando true, o agente responde SOZINHO as mensagens que
  // chegam na instância vinculada (via webhook), sem atendente. false = só
  // copiloto (sugestões/resumos como hoje).
  autoRespond Boolean @default(false)

  // "Aprendizados" — bloco vivo injetado no prompt DEPOIS do manual. Começa
  // curado à mão (correções que o gestor anota); no futuro é alimentado por
  // revisão automática dos atendimentos (handoffs, correções de humano).
  learnings String? @db.Text

  // Checklist de qualificação (ICP) — UMA informação por linha (ex.: "Nome",
  // "Nome da empresa", "Ramo de atuação", "Já anuncia online?"). O agente
  // coleta TODAS naturalmente (uma por vez) antes de oferecer agendamento;
  // o que foi coletado vai no resumo da triagem.
  qualificationChecklist String? @db.Text

  // Link de agendamento (Google Calendar, Calendly, etc.). Quando preenchido, o
  // sistema injeta a URL EXATA no prompt — o modelo copia sem errar, em vez de
  // depender de lembrar o link do meio do manual.
  schedulingLink String?

  // Agendamento DIRETO no chat: quando calendarUserId aponta pra um usuário com
  // Google Calendar conectado (UserGoogleConnection service=calendar), o agente
  // consulta a agenda + horários de atendimento, oferece slots livres e cria o
  // evento com Google Meet sozinho. Sem vínculo → fallback pro schedulingLink.
  calendarUser       User?   @relation("AssistantCalendarUser", fields: [calendarUserId], references: [id], onDelete: SetNull)
  calendarUserId     String?
  meetingDurationMin Int     @default(30) // duração da reunião oferecida

  // Sentinela de espera: conversa pausada (humano assumiu) + mensagem do
  // contato sem resposta há N minutos → aviso automático de recebimento
  // (sem marcar a conversa como respondida). 0 = desligada.
  courtesyDelayMin Int     @default(5)
  courtesyText     String? @db.Text // null = texto padrão do sistema

  // Vínculo opcional a uma instância WhatsApp (roteamento por número de entrada).
  instance   WhatsappInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  instanceId String?

  // Overrides opcionais do modelo (caem no default global quando nulos).
  model       String? // ex.: "gpt-4o-mini"
  temperature Float?

  usageLogs   AiUsageLog[]
  routes      AssistantRoute[]
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, type, isActive])
  @@index([instanceId])
}

// Mensagem WhatsApp agendada pra envio futuro (lembrete de reunião, follow-up).
// Processada pelo cron /api/cron/scheduled-messages (loop no start.sh).
model ScheduledMessage {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  instance   WhatsappInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  instanceId String?

  phone  String
  body   String   @db.Text
  sendAt DateTime // quando enviar

  status    String    @default("PENDING") // PENDING | SENT | FAILED | CANCELED
  kind      String? // "meeting_reminder" | ...
  meta      Json? // ex.: { eventId, meetLink, conversationId }
  sentAt    DateTime?
  lastError String?

  createdAt DateTime @default(now())

  @@index([status, sendAt])
  @@index([companyId, phone])
}

// Rota de triagem do agente autônomo: mapeia a INTENÇÃO identificada pela IA
// (token livre, ex.: "COMERCIAL", "ATENDIMENTO") para o Setor que assume a
// conversa. Genérico de propósito — novo setor = nova rota cadastrada, sem
// mexer em código.
model AssistantRoute {
  id          String    @id @default(cuid())
  assistant   Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  assistantId String

  intent String // token que a IA devolve na action (ex.: "COMERCIAL")
  label  String? // nome amigável na UI ("Time comercial")

  setor   Setor  @relation(fields: [setorId], references: [id], onDelete: Cascade)
  setorId String

  // Ao rotear, criar/atualizar Lead no CRM com o resumo da qualificação
  // (típico da rota comercial).
  createLead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assistantId, intent])
  @@index([setorId])
}

enum AssistantType {
  PRE_ATENDENTE // triagem / 1º contato / roteamento
  VENDAS // negociação: conduz lead/oportunidade até comprar
  SUPORTE // atendimento a quem já é cliente
  FINANCEIRO // boletos, notas, cobranças (hospedagem/domínio)
  GESTOR // resumos e apoio à decisão do dono
}

// Log de cada chamada de IA — base do controle de consumo e relatório de custo.
// 1 registro = 1 interação. tokensPrompt/tokensCompletion vêm do response.usage
// da OpenAI (custo real), mesmo que a cobrança ao cliente seja por interação.
model AiUsageLog {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  assistant   Assistant? @relation(fields: [assistantId], references: [id], onDelete: SetNull)
  assistantId String?

  endpoint         String // "suggest-reply" | "summarize" | "atendimento" | etc.
  model            String // modelo efetivamente usado
  tokensPrompt     Int     @default(0)
  tokensCompletion Int     @default(0)
  tokensTotal      Int     @default(0)
  userId           String? // quem disparou (opcional)

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([assistantId])
}

// ─── Catálogo de Serviços ─────────────────────────────────────────────────────
// Serviço = CONHECIMENTO que os agentes consultam (não é um agente). O agente de
// Vendas/Pré-atendente usa o catálogo pra reconhecer o que o contato quer e fazer
// as perguntas de qualificação certas. priceRange é de USO INTERNO — NÃO é
// injetado no prompt do SDR (que nunca informa preço).
model Service {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  name                String // "Criação de Sites", "Gestão de Redes Sociais"
  description         String? @db.Text
  // Perguntas de qualificação (uma por linha) — o agente usa pra coletar.
  qualifyingQuestions String? @db.Text
  // Argumentos de venda / como apresentar (pro futuro agente de Vendas).
  salesArguments      String? @db.Text
  // Referências, cases, materiais, links.
  references          String? @db.Text
  // Faixa de preço — uso interno do gestor. NÃO entra no prompt do SDR.
  priceRange          String?

  isActive         Boolean @default(true)
  // Aparece na área do cliente ("Disponível para você"). Independente de isActive
  // (que controla o uso pela IA). Um serviço pode servir só à IA, só ao cliente, ambos.
  showInClientArea Boolean @default(false)
  order            Int     @default(0)

  clientInstances ClientService[] // contratações deste serviço por clientes
  projects        SetorClickupList[] @relation("ServiceProjects") // projetos que entregam este serviço (carro-chefe)
  projectSteps    ProjectService[]   @relation("ServiceProjectLinks") // etapas de projeto que entregam este serviço

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, isActive])
}

// Serviço CONTRATADO por um cliente (empresa). Um cliente pode ter VÁRIOS —
// inclusive N do mesmo serviço (ex.: 3 hospedagens). Cada registro é uma
// instância com os detalhes daquele contrato. Origem opcional no catálogo (Service).
model ClientService {
  id              String   @id @default(cuid())
  clientCompany   Company  @relation("ClientServiceClient", fields: [clientCompanyId], references: [id], onDelete: Cascade)
  clientCompanyId String
  service         Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceId       String?

  label    String // apelido desta instância (ex.: "Hospedagem site principal")
  status   String    @default("ATIVO") // ATIVO | EM_IMPLANTACAO | PAUSADO | ENCERRADO
  renewsAt DateTime? // renovação/vencimento
  url      String? // link/acesso
  notes    String?   @db.Text
  details  Json? // campos extras flexíveis: [{ "label": string, "value": string }]
  order    Int       @default(0)

  invoices ClientInvoice[] // cobranças ligadas a este serviço

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientCompanyId])
  @@index([serviceId])
}

// Cobrança (fatura/boleto/NF) que a agência EMITE para um cliente. Alimentada
// manualmente hoje; estrutura pronta pra baixa automática via retorno CNAB
// (externalId = nosso número) no futuro.
model ClientInvoice {
  id              String         @id @default(cuid())
  clientCompany   Company        @relation("ClientInvoiceClient", fields: [clientCompanyId], references: [id], onDelete: Cascade)
  clientCompanyId String
  clientService   ClientService? @relation(fields: [clientServiceId], references: [id], onDelete: SetNull)
  clientServiceId String?

  description    String
  referenceMonth String? // competência "YYYY-MM"
  amountCents    Int // valor em centavos (evita Decimal na serialização)
  dueDate        DateTime // vencimento
  status         String    @default("ABERTO") // ABERTO | PAGO | CANCELADO (atraso é derivado do vencimento)
  paidAt         DateTime? // data de liquidação (baixa)
  boletoUrl      String? // link/PDF do boleto ou linha digitável
  invoiceUrl     String? // link da nota fiscal (NF)
  notes          String?   @db.Text

  externalId String? // nosso número / id do boleto no sistema/banco
  provider   String? // origem (ex.: "manual", "banco X")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientCompanyId, status])
  @@index([clientServiceId])
}

// ─── Vídeos (módulo moduleVideos) ────────────────────────────────────────────
// Biblioteca de vídeos estilo Netflix (material de apoio). Cada VideoCategory é
// uma "trilha" (fileira). O escopo define quem é dono e como é liberada:
//   GLOBAL  → biblioteca central do SUPER_ADMIN (Lazzari). companyId = null.
//   COMPANY → trilha de uma agência (companyId = dona), pros clientes dela.
// A visibilidade controla o "liberar":
//   ALL      → aparece pra todo cliente elegível (do escopo).
//   SELECTED → só pras empresas listadas em VideoCategoryRelease.
// O cliente (sub-empresa) enxerga: trilhas GLOBAL liberadas + trilhas COMPANY
// da sua agência-pai liberadas. Mesma lógica de Service.showInClientArea.

enum VideoCategoryScope {
  GLOBAL // biblioteca central do super admin
  COMPANY // trilha própria de uma agência
}

enum VideoCategoryVisibility {
  ALL // todo cliente elegível do escopo vê
  SELECTED // só empresas liberadas em VideoCategoryRelease
}

model VideoCategory {
  id          String                  @id @default(cuid())
  title       String
  description String?                 @db.Text
  emoji       String? // ícone opcional exibido na fileira (ex.: "🎬")
  accent      String? // cor de destaque opcional (hex, ex.: "#8B5CF6")
  position    Int                     @default(0)
  active      Boolean                 @default(true)
  scope       VideoCategoryScope      @default(GLOBAL)
  visibility  VideoCategoryVisibility @default(SELECTED)

  // Dona da trilha quando scope=COMPANY (null quando GLOBAL/central).
  companyId String?
  company   Company? @relation("CompanyVideoCategories", fields: [companyId], references: [id], onDelete: Cascade)

  videos   Video[]
  releases VideoCategoryRelease[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([scope, active])
}

// Liberação de uma trilha pra uma empresa específica (quando visibility=SELECTED).
model VideoCategoryRelease {
  id         String        @id @default(cuid())
  categoryId String
  category   VideoCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // Empresa que ganhou acesso (sub-empresa cliente).
  companyId  String
  company    Company       @relation("CompanyVideoReleases", fields: [companyId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@unique([categoryId, companyId])
  @@index([companyId])
}

model Video {
  id            String        @id @default(cuid())
  categoryId    String
  category      VideoCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title         String
  description   String?       @db.Text
  youtubeId     String // ID do vídeo no YouTube (extraído da URL no cadastro)
  thumbnailUrl  String? // capa custom; se null, usa a thumb padrão do YouTube
  durationLabel String? // ex.: "12:34" (opcional, só exibição)
  position      Int           @default(0)
  active        Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, active])
}
