// Config por empresa: quais eventos contam como conversão no LeadHub, rótulo amigável,
// e se devem ser ocultados da lista do dashboard. Independente do que o admin do GA4
// marcou como "key event" — o cliente do LeadHub decide aqui.
model MarketingEventConfig {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source    String // "ga4"
  eventName String

  isConversion Boolean @default(false)
  displayLabel String? // "Lead WhatsApp" / "Formulário enviado" — usado nos cards
  hidden       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, source, eventName])
  @@index([companyId])
}

model SearchConsoleQuery {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date

  query   String
  page    String?
  country String? // "bra"
  device  String? // "MOBILE" | "DESKTOP" | "TABLET"

  clicks      Int
  impressions Int
  ctr         Float // 0..1
  position    Float // posição média

  @@unique([companyId, date, query, page, country, device])
  @@index([companyId, date])
  @@index([companyId, query])
}

// ─── Google Business Profile (GBP / "Meu Negócio") ────────────────────────────
//
// Espelha o padrão do GA4 / Search Console: 1 MarketingIntegration (provider=
// BUSINESS_PROFILE) representa 1 location escolhida. Cron diário roda syncGbp
// que popula as tabelas abaixo. Range padrão 30 dias.
//
// Dados origem (4 APIs):
//   - businessprofileperformance.googleapis.com → insights (views, actions) + keywords
//   - mybusiness.googleapis.com/v4 (legacy)     → reviews
//   - mybusinessbusinessinformation.googleapis.com → profile

// 1 linha/dia/empresa — KPIs operacionais do perfil
model GbpInsight {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  date      DateTime @db.Date

  // Impressões (views do perfil)
  impressionsSearchDesktop Int @default(0)
  impressionsSearchMobile  Int @default(0)
  impressionsMapsDesktop   Int @default(0)
  impressionsMapsMobile    Int @default(0)

  // Ações
  callClicks        Int @default(0)
  websiteClicks     Int @default(0)
  directionRequests Int @default(0)
  conversations     Int @default(0)
  bookings          Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, date])
  @@index([companyId, date])
}

// 1 linha/review — usada em card "últimas reviews" + KPI rating médio
model GbpReview {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  // ID externo do Google (accounts/X/locations/Y/reviews/Z)
  googleReviewId String @unique

  reviewerName     String?
  reviewerPhotoUrl String?
  starRating       Int // 1-5
  comment          String?   @db.Text
  createTime       DateTime
  updateTime       DateTime?

  // Resposta do dono (se houver)
  replyComment    String?   @db.Text
  replyUpdateTime DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, createTime])
  @@index([companyId, starRating])
}

// Termo de busca → impressões mensais (granularidade que a API entrega)
model GbpSearchKeyword {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  keyword     String
  year        Int
  month       Int // 1-12
  impressions Int // pode ser threshold ("<15")
  isThreshold Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([companyId, year, month, keyword])
  @@index([companyId, year, month])
}

// Snapshot do perfil — espelho dos campos + completenessScore calculado
model GbpProfileSnapshot {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  title             String?
  primaryCategory   String?
  storefrontAddress Json?
  primaryPhone      String?
  websiteUri        String?
  regularHours      Json?
  description       String? @db.Text
  photoCount        Int?
  // 0-100 — quanto está preenchido. Card "Profile Health" mostra checks faltando.
  completenessScore Int

  // Agregados vindos do response da API v4 reviews (top-level averageRating +
  // totalReviewCount). Fallback pro card "Avaliação média" quando reviews
  // individuais não vêm pela paginação.
  googleAverageRating Float?
  googleReviewCount   Int?

  syncedAt DateTime @default(now())

  @@index([companyId, syncedAt])
}

// ─── Cobrança / Assinaturas ───────────────────────────────────────────────────
//
// Cada Company tem 1 Subscription. Na pivô pra "vender pro cliente final", a
// hierarquia é simplificada: top-level companies (parentCompanyId=null) pagam.
// Sub-companies, se existirem no futuro, herdam plano da pai.
//
// Estados típicos:
//  TRIALING → primeiros 14 dias após signup, sem cartão
//  ACTIVE → assinatura paga e em dia
//  PAST_DUE → pagamento falhou, em período de graça (5 dias)
//  CANCELED → cancelado pelo cliente, ainda ativo até currentPeriodEnd
//  UNPAID → não pagou, acesso bloqueado
//  INCOMPLETE → checkout iniciado mas não finalizado

model Subscription {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  plan         PlanTier           @default(TRIAL)
  status       SubscriptionStatus @default(TRIALING)
  billingCycle String             @default("monthly") // "monthly" | "annual"

  // Trial
  trialEndsAt DateTime?

  // Período corrente (válido pra ACTIVE/CANCELED)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?

  // Stripe
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  // Cache de cartão (last4, brand) só pra mostrar na UI — sem dado sensível
  cardBrand String?
  cardLast4 String?

  // ─── Overrides por cliente (super admin define manualmente) ──────────────
  // Usado principalmente no plano FREE pra liberar limites/features
  // específicos de cada cliente (parceiros, amigos, beta testers, lifetime deals).
  // Quando preenchido, prevalece sobre os defaults do plano.
  // Estrutura esperada (validada no app, não no DB):
  //   customLimits   = { whatsappInstances?:n, atendentes?:n, unidades?:n, leadsPerMonth?:n }
  //   customFeatures = { marketingDashboard?:bool, cofreCredenciais?:bool, ... }
  customLimits   Json?
  customFeatures Json?
  /// Anotação livre só pra você lembrar por que aquele cliente tem override
  customNotes    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([trialEndsAt])
}

enum PlanTier {
  FREE
  TRIAL
  ESSENCIAL
  MARKETING
  CRESCIMENTO
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
}

// ─── Horário de Atendimento ───────────────────────────────────────────────────
// Configuração por dia da semana. Intervalos (pausas) ficam em BusinessHoursInterval.
// Usado pelo motor de gamificação para calcular tempo de resposta dentro do horário útil.

model BusinessHoursConfig {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0=dom … 6=sáb
  isOpen    Boolean  @default(true)
  openTime  String   @default("09:00") // "HH:MM"
  closeTime String   @default("18:00") // "HH:MM"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  intervals BusinessHoursInterval[]

  @@unique([companyId, dayOfWeek])
  @@index([companyId])
}

model BusinessHoursInterval {
  id        String              @id @default(cuid())
  configId  String
  config    BusinessHoursConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  startTime String // "HH:MM"
  endTime   String // "HH:MM"
  label     String? // "Almoço", "Reunião de equipe", etc.

  @@index([configId])
}

// ─── Sistema de Prêmios ───────────────────────────────────────────────────────
// Catálogo configurável pela empresa: ☕ café (100 pts) → ✈️ viagem (15k pts).
// Resgate debita redeemablePoints, gera RewardRedemption pendente que admin
// aprova/recusa.

model Reward {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  cost        Int
  available   Boolean  @default(true)
  imageUrl    String?
  stock       Int? // null = ilimitado
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  redemptions RewardRedemption[]

  @@index([companyId, available])
}

model RewardRedemption {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rewardId   String
  reward     Reward           @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  rewardName String // snapshot
  cost       Int
  status     RedemptionStatus @default(PENDING)
  notes      String? // admin note (motivo de rejeição, etc.)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  resolvedAt DateTime?

  @@index([userId, createdAt])
  @@index([companyId, status])
}

enum RedemptionStatus {
  PENDING // aguardando aprovação do admin
  APPROVED // aprovado, em trânsito
  DELIVERED // entregue
  REJECTED // recusado (pontos devolvidos)
}

// ─── Gamificação ──────────────────────────────────────────────────────────────
// Pontuação mensal e histórica por usuário. monthPoints reseta no dia 1 de
// cada mês via cron. totalPoints nunca zera (histórico vitalício).

model UserScore {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  totalPoints      Int      @default(0) // histórico vitalício (nunca decrementa via resgate)
  monthPoints      Int      @default(0) // do mês corrente (reseta dia 1)
  redeemablePoints Int      @default(0) // disponíveis pra trocar por prêmios
  month            Int
  year             Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([companyId, month, year])
  @@index([userId])
}

model UserBadge {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  badge     BadgeType
  tier      Int       @default(1) // 1-6, definição em src/app/(admin)/gamificacao/labels.ts
  earnedAt  DateTime  @default(now())

  @@unique([userId, badge, tier])
  @@index([userId])
  @@index([companyId])
}

model ScoreEvent {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  points      Int
  reason      ScoreReason
  referenceId String?
  // Para incidentes manuais (reason=INCIDENTE) e bônus customizados:
  description String?     @db.Text // o que aconteceu / contexto
  authorId    String? // quem registrou
  authorName  String? // snapshot (caso author seja deletado)
  createdAt   DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([companyId, createdAt])
}

// Configuração de regras de pontuação por empresa.
// Override do SCORE_TABLE em src/lib/gamification.ts.
model ScoreRuleConfig {
  id             String      @id @default(cuid())
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reason         ScoreReason
  enabled        Boolean     @default(true)
  points         Int
  // Quando false, o ScoreEvent é criado (badge conta) mas o UserScore NÃO
  // recebe os pontos — útil pra impedir que VENDAS dominem o ranking mensal.
  affectsRanking Boolean     @default(true)
  updatedAt      DateTime    @updatedAt

  @@unique([companyId, reason])
  @@index([companyId])
}

enum BadgeType {
  RAIO_VELOZ // 50 respostas em <5min no mês
  SPRINT_MASTER // 7 dias sem atraso
  PRIMEIRO_DO_DIA // 1a resposta do dia 3x seguidas
  RESOLVEDOR // 20 tickets resolvidos
  ZERO_PENDENCIA // semana sem conversa aberta
  ANTECIPADOR // 10 retornos cumpridos antes do prazo
  CLOSER // 5 conversões de lead no mês
  FUNIL_COMPLETO // lead avançou todas as etapas em <7 dias
  REI_DO_MES // 1o lugar no ranking mensal
  PONTUAL // dias terminados sem nada atrasado
  ENTREGADOR // projetos entregues no prazo
  CONSTRUTOR // tarefas concluídas no ClickUp
  ENGAJADO // tarefas atualizadas no ClickUp
  GERADOR // tarefas criadas no ClickUp
  // Easter eggs — escondidas pra não-admin até desbloquearem
  CORUJA // respostas após o expediente (após 22h, dia útil)
  MADRUGADOR // respostas antes das 7h
  SORTUDO // lead criado e fechado no mesmo dia
  FENIX // lead que estava LOST e voltou pra CLOSED
  // Colaboração / ajuda mútua entre atendentes
  EXERCITO // responde conversa de outro responsável quando cliente espera
  LIDER // encaminha conversa pra colega adequado (muda assignee/setor)
  GUARDIAO // primeiro a responder em conversa nova sem responsável
  // Mestres do Ofício — chamados próprios (gamificação de tickets)
  ALQUIMISTA // atualiza/comenta no próprio chamado (constância)
  SNIPER // resolveu chamado antes do dueDate (precisão)
  TROVAO // chamado criado e resolvido no mesmo dia (velocidade)
  // Atendimento em grupos — clientes que conversam em grupo do WhatsApp
  DIPLOMATA // primeira resposta em grupo novo (variedade de relacionamentos)
  PRECISO // resposta rápida em grupo (≤5min úteis após cliente)
  NETWORK // dia em que respondeu em 3+ grupos diferentes
}

enum ScoreReason {
  RESPOSTA_RAPIDA_5MIN
  RESPOSTA_RAPIDA_30MIN
  TICKET_RESOLVIDO
  LEAD_AVANCADO
  LEAD_CONVERTIDO
  DIA_SEM_PENDENCIA
  DIA_SEM_ATRASO // dia terminado sem dueDate/scheduledReturnAt vencidos
  RETORNO_ANTECIPADO
  ATENDIMENTO_MESMO_DIA
  NOTA_REGISTRADA
  PRIMEIRO_CONTATO // triagem / "estamos encaminhando" em conversa de outro
  PROJETO_ENTREGUE // projeto marcado como ENTREGUE
  PROJETO_ENTREGUE_NO_PRAZO // bônus quando deliveredAt <= dueDate
  SLA_VENCIDO
  CONVERSA_SEM_RESPOSTA
  PRAZO_PRORROGADO // empurrar prazo depois de já vencido
  PROJETO_ATRASADO // projeto entregue depois do dueDate
  TAREFA_SEM_PRAZO // tarefas no ClickUp sem due_date (cron diário)
  TAREFA_CRIADA // tarefa criada no ClickUp (sync)
  TAREFA_ATUALIZADA // tarefa atualizada no ClickUp (sync)
  TAREFA_CONCLUIDA // tarefa concluída no ClickUp (sync)
  TAREFA_ATRASADA // tarefa overdue no ClickUp (cron diário)
  TAREFA_SEM_RESPONSAVEL // tarefa sem assignee no ClickUp (cron diário)
  STREAK_DIA // dia consecutivo sem atraso (alimenta SPRINT_MASTER)
  BONUS_NOITE // mensagem fora do horário comercial (Coruja)
  BONUS_MADRUGADA // mensagem antes das 7h (Madrugador)
  BONUS_VENDA_RAPIDA // lead criado e fechado mesmo dia (Sortudo)
  BONUS_RECUPERACAO // lead LOST → CLOSED (Fênix)
  BONUS_SUPEROU_MES // mês corrente > mês anterior em pontos
  INCIDENTE // penalidade manual registrada por admin (ex: descuido com cliente)
  AJUDA_EXERCITO // respondeu cliente em conversa de outro responsável (Exército)
  ENCAMINHAMENTO // encaminhou conversa pra colega adequado (Líder)
  PRIMEIRA_RESPOSTA // primeiro a responder em conversa sem responsável (Guardião)
  TICKET_ATUALIZADO // atualização/comentário no próprio chamado (Alquimista)
  TICKET_NO_PRAZO // chamado resolvido antes do dueDate (Sniper)
  TICKET_RESOLVIDO_MESMO_DIA // chamado criado e resolvido no mesmo dia (Trovão)
  ATENDIMENTO_GRUPO_NOVO // primeira resposta num grupo novo (Diplomata)
  RESPOSTA_RAPIDA_GRUPO // resposta em grupo em ≤5min úteis (Preciso)
  DIA_NETWORK // dia em que respondeu em 3+ grupos diferentes (Network)
  LEAD_VIROU_OPORTUNIDADE // lead promovido pra oportunidade (cliente pediu orcamento)
  TAREFA_LEADHUB_FEITA // marcou tarefa do LeadHub como feita (não confundir com TAREFA_CONCLUIDA do ClickUp)
  SINAL_QUENTE_RESPONDIDO // marcou tarefa AUTO_LINK_OPEN feita (cliente abriu proposta → vendedor agiu rápido)
}

// ─── Push Notifications (Web Push API) ───────────────────────────────────────
// Cada navegador/device do usuário tem uma PushSubscription. Quando o usuário
// permite notificações, o frontend envia o objeto subscription pra cá. Os hooks
// do servidor (mensagem nova, sinal quente etc.) percorrem todas as subs ativas
// do destinatário e disparam.

model PushSubscription {
  id        String  @id @default(cuid())
  endpoint  String  @unique // URL única do push service do browser
  p256dh    String // chave pública (criptografia VAPID)
  auth      String // segredo compartilhado
  userAgent String? // pra UI mostrar "Chrome no Mac" etc.

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Quando uma notificação retorna 410 Gone, a sub é apagada.
  lastFailedAt DateTime?
  failCount    Int       @default(0)

  createdAt DateTime @default(now())

  @@index([userId])
}

model UserNotifPreferences {
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  // Liga/desliga categorias específicas
  newMessage  Boolean @default(true) // chegou mensagem WhatsApp em conversa que é minha
  hotSignal   Boolean @default(true) // tarefa AUTO_LINK_OPEN criada
  taskOverdue Boolean @default(false) // ainda não tem cron, deixa off
  followUp    Boolean @default(true) // resumo diário: leads/oportunidades pra retornar + esfriando

  updatedAt DateTime @updatedAt
}

// ─── Email Marketing (módulo moduleEmailMarketing) ───────────────────────────
// Cada empresa-cliente com o módulo ligado configura o próprio SMTP e dispara
// campanhas pros leads. Worker (pg-boss) processa com cadência. Tracking de
// abertura/clique + compliance LGPD (unsubscribe + suppression list).

// SMTP próprio da empresa (separado do SMTP global do sistema, que fica em Setting).
model CompanyEmailConfig {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String  @unique

  host      String
  port      Int     @default(465)
  secure    Boolean @default(true)
  user      String
  // Senha em AES-256-GCM (mesmo formato do cofre / crypto.ts).
  passEnc   String
  fromEmail String // remetente fixo das campanhas
  fromName  String // "Diego — AZZ Agência"
  // Quando preenchido, vai no header Reply-To — cliente que responde
  // o email vai pra este endereço, não pro fromEmail. Útil quando o SMTP
  // exige que From == usuário autenticado mas você quer receber respostas
  // numa caixa diferente.
  replyTo   String?

  // Status da última verificação de conexão
  verified       Boolean   @default(false)
  lastVerifiedAt DateTime?
  lastError      String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailTemplate {
  id      String  @id @default(cuid())
  name    String // "Proposta padrão", "Follow-up 7 dias"
  subject String // pode usar {{nome}}
  html    String  @db.Text // corpo HTML com {{vars}}
  text    String? @db.Text // fallback texto puro (auto-gerado se vazio)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  campaigns EmailCampaign[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([companyId])
}

model EmailCampaign {
  id          String              @id @default(cuid())
  name        String
  subject     String
  template    EmailTemplate       @relation(fields: [templateId], references: [id])
  templateId  String
  status      EmailCampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  // Cadência: { maxPerHour, jitterMs:[min,max], windowStart, windowEnd, daysOfWeek, timezone }
  cadenceConfig Json
  // Segmento (snapshot): { pipeline?, pipelineStage?, tagIds?: string[], hasEmail: true }
  segmentFilter Json

  // Stats (atualizados pelo worker)
  totalRecipients   Int @default(0)
  sentCount         Int @default(0)
  deliveredCount    Int @default(0)
  openedCount       Int @default(0)
  clickedCount      Int @default(0)
  bouncedCount      Int @default(0)
  unsubscribedCount Int @default(0)
  failedCount       Int @default(0)

  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId   String
  createdBy   User?   @relation("EmailCampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  recipients    EmailRecipient[]
  // Leads que foram promovidos (Prospect→Lead etc.) por engajamento com esta campanha.
  promotedLeads Lead[]           @relation("CampaignPromotedLeads")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([companyId, status])
  @@index([scheduledAt])
}

enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  COMPLETED
  FAILED
}

model EmailRecipient {
  id         String        @id @default(cuid())
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  lead       Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId     String?
  email      String // snapshot no momento de criação
  name       String?
  vars       Json? // variáveis renderizadas { nome, empresa, valor… }

  status         EmailRecipientStatus @default(PENDING)
  sentAt         DateTime?
  firstOpenedAt  DateTime?
  firstClickedAt DateTime?
  bouncedAt      DateTime?
  errorMessage   String?              @db.Text

  // token curto usado em pixel/click/unsubscribe
  token String @unique @default(cuid())

  events    EmailEvent[]
  createdAt DateTime     @default(now())
  // @default(now()) garante que linhas existentes recebam um valor quando
  // a coluna for adicionada via `db push` (sem isso, Prisma não consegue
  // adicionar a coluna NOT NULL e pula silenciosamente).
  updatedAt DateTime     @default(now()) @updatedAt

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([status, updatedAt]) // pra resetar SENDING travado
  @@index([token])
}

enum EmailRecipientStatus {
  PENDING
  SENDING
  SENT
  BOUNCED
  FAILED
  SKIPPED
}

model EmailEvent {
  id          String         @id @default(cuid())
  recipient   EmailRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String
  type        EmailEventType
  targetUrl   String?        @db.Text
  ipAddress   String?
  userAgent   String?        @db.Text
  createdAt   DateTime       @default(now())

  @@index([recipientId, type])
  @@index([type, createdAt])
}

enum EmailEventType {
  OPEN
  CLICK
  BOUNCE
  COMPLAINT
  UNSUBSCRIBE
}

model EmailUnsubscribe {
  id        String   @id @default(cuid())
  email     String // normalizado (lowercase)
  reason    String?
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  createdAt DateTime @default(now())

  @@unique([email, companyId])
  @@index([email])
}

// Trilha de auditoria de eventos de cobrança — útil pra suporte e debug.
model BillingEvent {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type     String // "trial_started" | "subscribed" | "upgraded" | "downgraded" | "canceled" | "payment_succeeded" | "payment_failed" | "trial_ended"
  fromPlan String?
  toPlan   String?
  amount   Float? // BRL
  metadata Json?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

// ─── Auditoria administrativa ─────────────────────────────────────────────────
// Trilha de ações sensíveis executadas por SUPER_ADMIN/ADMIN (impersonation,
// override de plano, alterações em outras empresas, etc.).
// Exigência B2B/LGPD: cliente precisa saber quando alguém da Lazzari logou
// como ele e o que foi feito.
//
// Estrutura propositalmente solta (sem FK para User/Company) pra não bloquear
// retenção: queremos manter o log mesmo se o usuário/empresa for excluído.
model AdminAuditLog {
  id String @id @default(cuid())

  adminUserId    String // quem executou (SUPER_ADMIN ou ADMIN)
  adminUserName  String?
  adminUserEmail String?

  action          String // "IMPERSONATE_START" | "IMPERSONATE_END" | "PLAN_OVERRIDE" | "MODULE_TOGGLE" | etc.
  targetCompanyId String? // empresa-alvo (null se ação não é em empresa específica)
  targetUserId    String? // usuário-alvo (ex.: reset de senha)

  ip        String?
  userAgent String? @db.Text
  metadata  Json? // payload extra: motivo, valores antes/depois, etc.

  createdAt DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([targetCompanyId, createdAt])
  @@index([action, createdAt])
}

// ─── Assistentes de IA (configuráveis por empresa) ────────────────────────────
// Cada Assistant é um "agente" com comportamento próprio definido por um manual
// editável (system prompt). O `type` define o papel; a UI/lógica usa o agente
// ATIVO de cada tipo. `instanceId` (opcional) vincula o agente a uma instância
// WhatsApp específica (ex.: número de vendas → agente VENDAS). A key da OpenAI é
// global; o consumo é controlado pela cota mensal da Company (ver aiMonthlyQuota).
model Assistant {
  id        String        @id @default(cuid())
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  name      String // nome amigável ("Closer de Vendas", "Suporte Financeiro")
  type      AssistantType
  // Manual de instruções = system prompt. Como agir, tom, objetivo, o que pode/
  // não pode dizer. É o coração do agente — editado pelo admin da empresa.
  manual    String        @db.Text
  isActive  Boolean       @default(true)

  // Link de agendamento (Google Calendar, Calendly, etc.). Quando preenchido, o
  // sistema injeta a URL EXATA no prompt — o modelo copia sem errar, em vez de
  // depender de lembrar o link do meio do manual.
  schedulingLink String?

  // Vínculo opcional a uma instância WhatsApp (roteamento por número de entrada).
  instance   WhatsappInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  instanceId String?

  // Overrides opcionais do modelo (caem no default global quando nulos).
  model       String? // ex.: "gpt-4o-mini"
  temperature Float?

  usageLogs   AiUsageLog[]
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, type, isActive])
  @@index([instanceId])
}

enum AssistantType {
  PRE_ATENDENTE // triagem / 1º contato / roteamento
  VENDAS // negociação: conduz lead/oportunidade até comprar
  SUPORTE // atendimento a quem já é cliente
  FINANCEIRO // boletos, notas, cobranças (hospedagem/domínio)
  GESTOR // resumos e apoio à decisão do dono
}

// Log de cada chamada de IA — base do controle de consumo e relatório de custo.
// 1 registro = 1 interação. tokensPrompt/tokensCompletion vêm do response.usage
// da OpenAI (custo real), mesmo que a cobrança ao cliente seja por interação.
model AiUsageLog {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  assistant   Assistant? @relation(fields: [assistantId], references: [id], onDelete: SetNull)
  assistantId String?

  endpoint         String // "suggest-reply" | "summarize" | "atendimento" | etc.
  model            String // modelo efetivamente usado
  tokensPrompt     Int     @default(0)
  tokensCompletion Int     @default(0)
  tokensTotal      Int     @default(0)
  userId           String? // quem disparou (opcional)

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([assistantId])
}

// ─── Catálogo de Serviços ─────────────────────────────────────────────────────
// Serviço = CONHECIMENTO que os agentes consultam (não é um agente). O agente de
// Vendas/Pré-atendente usa o catálogo pra reconhecer o que o contato quer e fazer
// as perguntas de qualificação certas. priceRange é de USO INTERNO — NÃO é
// injetado no prompt do SDR (que nunca informa preço).
model Service {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  name                String // "Criação de Sites", "Gestão de Redes Sociais"
  description         String? @db.Text
  // Perguntas de qualificação (uma por linha) — o agente usa pra coletar.
  qualifyingQuestions String? @db.Text
  // Argumentos de venda / como apresentar (pro futuro agente de Vendas).
  salesArguments      String? @db.Text
  // Referências, cases, materiais, links.
  references          String? @db.Text
  // Faixa de preço — uso interno do gestor. NÃO entra no prompt do SDR.
  priceRange          String?

  isActive Boolean @default(true)
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, isActive])
}
