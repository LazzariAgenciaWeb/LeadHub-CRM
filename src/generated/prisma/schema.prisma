model AnalyticsGeoData {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  source    String // "ga4"

  countryCode String? // "BR", "US"
  countryName String?
  region      String? // estado / província
  city        String?

  sessions Int @default(0)
  users    Int @default(0)

  @@unique([companyId, date, source, countryCode, region, city])
  @@index([companyId, date])
}

// Eventos GA4 por dia (padrão como page_view/scroll/click + personalizados).
// Sync diário popula. UI mostra a lista pra cliente marcar quais são conversão (ver MarketingEventConfig).
model AnalyticsEventDaily {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  source    String // "ga4"

  eventName  String
  eventCount Int    @default(0)
  users      Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, date, source, eventName])
  @@index([companyId, date])
  @@index([companyId, eventName])
