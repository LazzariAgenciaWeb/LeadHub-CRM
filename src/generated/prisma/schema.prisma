generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Usuários ─────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(CLIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Assinatura exibida no início das mensagens WhatsApp enviadas pelo usuário
  whatsappSignature        String?
  // Se true (default), o checkbox "Assinar como X" no compositor de mensagem
  // do WhatsApp começa marcado. Usuário pode desligar pra ter de marcar manual
  // a cada envio.
  whatsappSignatureDefault Boolean @default(true)

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?

  ticketsCreated        Ticket[]               @relation("TicketCreatedBy")
  ticketsAssigned       Ticket[]               @relation("TicketAssignee")
  companyContact        CompanyContact?        @relation("ContactUser")
  setores               SetorUser[]
  conversationsAssigned Conversation[]         @relation("ConversationAssignee")
  googleConnections     UserGoogleConnection[]
  vaultChallenges       VaultEmailChallenge[]
  vaultTrustedSessions  VaultTrustedSession[]
  userScores            UserScore[]
  userBadges            UserBadge[]
  scoreEvents           ScoreEvent[]
  projectMemberships    ProjectMember[]
  rankingCategory       RankingCategory        @default(PRODUCAO)
  // Timestamp da última vez que o user "viu" os badges — pra toast de novidades
  lastBadgeSeenAt       DateTime?
  rewardRedemptions     RewardRedemption[]
  messagesSent          Message[]              @relation("MessageSentBy")
  tasksAssigned         Task[]                 @relation("TaskAssignee")
  tasksCreated          Task[]                 @relation("TaskCreatedBy")
  projectTasksAssigned  ProjectTask[]          @relation("ProjectTaskAssignee")
  projectTasksCreated   ProjectTask[]          @relation("ProjectTaskCreatedBy")
  ticketAccess          TicketAccessUser[]
  projectAccess         ProjectAccessUser[]
  pushSubscriptions     PushSubscription[]
  notifPreferences      UserNotifPreferences?
  emailCampaignsCreated EmailCampaign[]        @relation("EmailCampaignCreatedBy")
  assistantsCreated     Assistant[]

  @@index([companyId])
}

// ─── 2FA por e-mail para revelar credenciais do cofre ─────────────────────────
// Cada vez que um usuário clica "Mostrar senha" e não tem trusted session
// ativa, geramos um código de 6 dígitos e enviamos para o e-mail dele.
// Após validar, criamos uma VaultTrustedSession de 15 min que dispensa
// novos códigos no intervalo.

model VaultEmailChallenge {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash     String // SHA-256 do código (não guardamos o texto claro)
  credentialId String? // credencial alvo (auditoria; não restringe a verify)

  attempts  Int      @default(0) // máx 5 tentativas por challenge
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model VaultTrustedSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

// ─── Conexões pessoais com Google (Calendar e futuros serviços por usuário) ───
// Diferente de MarketingIntegration (por empresa, GA4/SC/GBP), aqui guardamos
// uma conexão OAuth por USUÁRIO. Cada atendente liga a própria conta Google
// para que o calendário pessoal apareça na vista "Meu Dia".

model UserGoogleConnection {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  service     String // "calendar" — extensível pra outros serviços pessoais
  googleEmail String?
  googleName  String?

  // OAuth tokens (criptografados via src/lib/crypto.ts — AES-256-GCM)
  accessTokenEnc  String?   @db.Text
  refreshTokenEnc String?   @db.Text
  tokenExpiresAt  DateTime?
  scopes          String[]  @default([])

  status     String    @default("ACTIVE") // ACTIVE | EXPIRED | DISCONNECTED | ERROR
  lastError  String?   @db.Text
  lastSyncAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, service])
  @@index([userId])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN // admin da empresa (gerencia usuários, setores, config)
  CLIENT // agente/atendente — permissões controladas pelo setor
}

// Categoria do ranking — separa Produção (atendentes/operação) de Gestão
// (gerentes/diretores). Cada categoria tem leaderboard próprio.
enum RankingCategory {
  PRODUCAO
  GESTAO
}

// ─── Empresas ─────────────────────────────────────────────────────────────────

model Company {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  segment   String?
  phone     String?
  email     String?
  website   String?
  logoUrl   String?
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Acesso ao sistema e módulos habilitados
  hasSystemAccess      Boolean @default(false) // pode fazer login no portal?
  moduleWhatsapp       Boolean @default(false)
  moduleCrm            Boolean @default(true)
  moduleTickets        Boolean @default(false)
  moduleAI             Boolean @default(false)
  moduleGamificacao    Boolean @default(false)
  moduleProjetos       Boolean @default(false)
  moduleCalendario     Boolean @default(false)
  // Disparo de email em massa (campanhas). Quando ligado, a empresa configura
  // o próprio SMTP em CompanyEmailConfig e dispara campanhas pros leads.
  moduleEmailMarketing Boolean @default(false)
  // Habilita busca de prospects via SerpAPI (Google Maps + scraper inline)
  // na página /crm/prospeccao. Cada empresa traz a própria `serpapiKey`.
  moduleProspeccao     Boolean @default(false)
  // API key SerpAPI da empresa (texto plano, mesmo padrão dos tokens de
  // integração atuais). Sem key, o botão "Buscar prospects" não aparece.
  serpapiKey           String?
  // Habilita a integração com ClickUp pra esta empresa. Quando false, a UI
  // de configuração e a sincronização (push + webhook) ficam desligadas.
  // Cada empresa-cliente liga o módulo e configura a própria conta ClickUp.
  moduleClickup        Boolean @default(false)
  // Módulo Campanhas (gerenciar campanhas + UTMs vinculadas a leads)
  moduleCampanhas      Boolean @default(false)
  // Módulo Links de rastreio (gera tracking links com pixel)
  moduleLinks          Boolean @default(false)
  // Módulo Instagram (automação estilo ManyChat): conecta a conta IG
  // Profissional via "API com Login do Instagram" e dispara respostas a
  // comentários + DM (private reply). Cada empresa conecta a própria conta.
  moduleInstagram      Boolean @default(false)

  // Define se a empresa usa WhatsApp em modo VISAO (read-only / painel de contexto)
  // ou ATENDE (completo, envia pelo painel). Default ATENDE preserva comportamento
  // das contas existentes — só contas novas no plano de entrada nascem como VISAO.
  modoAtendimento ModoAtendimento @default(ATENDE)

  // ─── Cota de uso de IA (Assistentes) ──────────────────────────────────────
  // A key da OpenAI é GLOBAL (do sistema). O controle de consumo é por empresa:
  // 1 "interação" = 1 chamada de IA (sugestão/resposta). Cota mensal que reseta.
  // aiMonthlyQuota  = limite de interações/mês (0 = bloqueado; setado pelo admin).
  // aiUsedThisMonth = contador do período atual.
  // aiQuotaResetAt  = quando o contador zera (início do próximo período mensal).
  aiMonthlyQuota  Int       @default(0)
  aiUsedThisMonth Int       @default(0)
  aiQuotaResetAt  DateTime?

  // Hierarquia: empresa-pai gerencia sub-empresas (clientes da empresa)
  parentCompanyId String?
  parentCompany   Company?  @relation("SubCompanies", fields: [parentCompanyId], references: [id])
  subCompanies    Company[] @relation("SubCompanies")

  users                     User[]
  userScores                UserScore[]
  userBadges                UserBadge[]
  scoreEvents               ScoreEvent[]
  scoreRuleConfigs          ScoreRuleConfig[]
  setorClickupListsAsClient SetorClickupList[]       @relation("SetorClickupListClient")
  rewards                   Reward[]
  rewardRedemptions         RewardRedemption[]
  businessHours             BusinessHoursConfig[]
  campaigns                 Campaign[]
  leads                     Lead[]
  tasks                     Task[]
  tags                      Tag[]
  customFieldDefs           CustomFieldDef[]
  emailConfig               CompanyEmailConfig?
  emailTemplates            EmailTemplate[]
  emailCampaigns            EmailCampaign[]
  emailUnsubscribes         EmailUnsubscribe[]
  // Campos personalizados definidos por este tenant — aplicam-se às próprias
  // empresas-cliente (sub-empresas) e à própria empresa.
  companyFieldDefs          CompanyCustomFieldDef[]  @relation("CompanyFieldDefOwner")
  companyCustomValues       CompanyCustomValue[]
  whatsappInstances         WhatsappInstance[]
  messages                  Message[]
  keywordRules              KeywordRule[]
  tickets                   Ticket[]
  ticketsAsClient           Ticket[]                 @relation("TicketClientCompany")
  trackingLinks             TrackingLink[]
  pipelineStages            PipelineStageConfig[]
  contacts                  CompanyContact[]
  setores                   Setor[]
  conversations             Conversation[]
  activities                Activity[]
  assets                    CompanyAsset[]
  credentialAccessLogs      CredentialAccessLog[]
  marketingIntegrations     MarketingIntegration[]
  instagramAccounts         InstagramAccount[]
  igAutomations             IgAutomation[]
  igAutomationRuns          IgAutomationRun[]
  analyticsSnapshots        AnalyticsSnapshot[]
  analyticsTopPages         AnalyticsTopPage[]
  analyticsTrafficSources   AnalyticsTrafficSource[]
  analyticsGeoData          AnalyticsGeoData[]
  analyticsEventDaily       AnalyticsEventDaily[]
  marketingEventConfig      MarketingEventConfig[]
  searchConsoleQueries      SearchConsoleQuery[]
  gbpInsights               GbpInsight[]
  gbpReviews                GbpReview[]
  gbpSearchKeywords         GbpSearchKeyword[]
  gbpProfileSnapshots       GbpProfileSnapshot[]
  subscription              Subscription?
  billingEvents             BillingEvent[]
  assistants                Assistant[]
  aiUsageLogs               AiUsageLog[]
  services                  Service[]
  triggerOnly               Boolean                  @default(false)
  webhookToken              String?                  @unique // token público para receber leads via webhook

  @@index([parentCompanyId])
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

// Modo de operação do WhatsApp para a empresa.
// VISAO  = somente leitura (espelho). Substitui o input de mensagem por
//          painel de contexto do lead. Equipe responde pelo celular.
// ATENDE = comportamento atual (envia, templates, transferência etc.).
enum ModoAtendimento {
  VISAO
  ATENDE
}

// ─── Campanhas ────────────────────────────────────────────────────────────────

model Campaign {
  id          String         @id @default(cuid())
  name        String
  slug        String
  description String?
  source      CampaignSource @default(OTHER)
  status      CampaignStatus @default(ACTIVE)
  budget      Float?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  leads        Lead[]
  messages     Message[]
  links        TrackingLink[]
  keywordRules KeywordRule[]

  @@unique([companyId, slug])
  @@index([companyId])
}

enum CampaignSource {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  GOOGLE
  LINK
  OTHER
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  FINISHED
}

// ─── Links de Rastreio ────────────────────────────────────────────────────────

model TrackingLink {
  id            String   @id @default(cuid())
  code          String   @unique
  label         String?
  destination   String
  destType      String   @default("url")
  clicks        Int      @default(0)
  // Quando false, o link permanece cadastrado e cliques continuam sendo
  // registrados (pra saber que o cliente tentou abrir), mas a página /r/CODE
  // não redireciona pro destino — mostra "proposta encerrada".
  isActive      Boolean  @default(true)
  ogTitle       String?
  ogDescription String?  @db.Text
  ogImage       String?
  createdAt     DateTime @default(now())

  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?

  leads       Lead[]
  clickEvents ClickEvent[]

  @@index([campaignId])
  @@index([companyId])
}

model ClickEvent {
  id             String         @id @default(cuid())
  trackingLink   TrackingLink   @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)
  trackingLinkId String
  targetUrl      String         @db.Text
  targetLabel    String?
  // OPEN  = cliente abriu o shortlink /r/CODE (entrou na proposta/landing)
  // INTERNAL = clicou em algum link/CTA DENTRO da página de destino (pixel script)
  kind           ClickEventKind @default(INTERNAL)
  createdAt      DateTime       @default(now())

  @@index([trackingLinkId])
  @@index([trackingLinkId, kind])
}

enum ClickEventKind {
  OPEN
  INTERNAL
}

// ─── Leads ────────────────────────────────────────────────────────────────────

model Lead {
  id        String     @id @default(cuid())
  name      String?
  phone     String
  email     String?
  source    String?
  status    LeadStatus @default(NEW)
  notes     String?    @db.Text
  value     Float?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // CRM Pipeline
  pipeline      String? // "PROSPECCAO" | "LEADS" | "OPORTUNIDADES"
  pipelineStage String? // nome da etapa configurável
  externalId    String? // ID externo (ex: id do Supabase BDR para evitar duplicatas)

  // Dados de prospect (preenchidos pela busca SerpAPI + scraper inline em /crm/prospeccao)
  website            String?
  instagram          String?
  facebook           String?
  address            String?
  city               String?
  segment            String? // categoria/segmento (ex: "Clínica Pediátrica", vem do `type` do Google Maps)
  // Validação Evolution: NULL = não validado, true/false = checado em /chat/whatsappNumbers
  hasWhatsapp        Boolean?
  // Diagnóstico IA (Prospecta IA → /api/prospeccao/diagnose). JSON com summary,
  // positives[], opportunities[], criticals[], sourceData{}. Token público leva
  // pro /d/[token] que mostra a análise e auto-promove o prospect pra LEADS no clique.
  diagnosis          Json?
  diagnosisAt        DateTime?
  diagnosisSource    String? // "website" | "instagram" | "none"
  diagnosisToken     String?   @unique
  diagnosisClickedAt DateTime?

  // Atendimento WhatsApp
  // @deprecated — espelho legacy de Conversation.status (mantido pra UI antiga via sync automático).
  // Leitura nova deve usar `lead.conversation.status`. Remover em migration futura.
  attendanceStatus String? // "WAITING" | "IN_PROGRESS" | "RESOLVED" | "SCHEDULED"
  expectedReturnAt DateTime? // previsão de retorno quando agendado

  // Integração ClickUp
  clickupTaskId String? // ID ou URL da tarefa no ClickUp

  // Visibilidade: isInternal=true → visível apenas ao SUPER_ADMIN (não aparece no portal do cliente)
  isInternal Boolean @default(false)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  campaignId String?

  trackingLink   TrackingLink? @relation(fields: [trackingLinkId], references: [id])
  trackingLinkId String?

  // ─── Rastreabilidade da promoção entre pipelines (atribuição) ─────────────
  // Setado pelos handlers de clique (shortlink e email) quando movem o lead
  // automático entre pipelines — alimenta relatórios de conversão.
  promotedFromPipeline       String? // "PROSPECCAO" | "LEADS"
  promotedAt                 DateTime?
  promotedReason             String? // "link_click" | "email_click" | "whatsapp_reply"
  promotedViaEmailCampaign   EmailCampaign? @relation("CampaignPromotedLeads", fields: [promotedViaEmailCampaignId], references: [id], onDelete: SetNull)
  promotedViaEmailCampaignId String?

  // Conversa unificada (uma conversa por telefone × empresa, criada no Sprint 1)
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  conversationId String?

  messages        Message[]
  comments        LeadComment[]
  activities      Activity[]
  tasks           Task[]
  tags            LeadTag[]
  customValues    LeadCustomValue[]
  emailRecipients EmailRecipient[]

  @@index([companyId])
  @@index([campaignId])
  @@index([phone, companyId])
  @@index([pipeline, companyId])
  @@index([externalId])
  @@index([conversationId])
}

// Tag colorida atribuível a leads. Configurada por empresa (cada empresa
// monta as próprias categorias: "VIP", "Quente", "Aguardando docs"…).
model Tag {
  id    String @id @default(cuid())
  name  String
  // Hex color usada nas chips. Default: indigo (combina com o tema).
  color String @default("#6366f1")
  // Ordem de exibição. Default 0 — usuário pode arrastar pra reordenar depois.
  order Int    @default(0)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  leads LeadTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Não duplicar tag com mesmo nome dentro da mesma empresa.
  @@unique([companyId, name])
  @@index([companyId, order])
}

// Pivot N:N Lead↔Tag. Composta como PK pra evitar duplicatas naturalmente.
model LeadTag {
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String

  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId String

  createdAt DateTime @default(now())

  @@id([leadId, tagId])
  @@index([tagId])
}

// ─── Custom Fields ────────────────────────────────────────────────────────────
// Cada empresa-cliente define os campos extras que faz sentido pra ela
// (clínica = "Convênio", imobiliária = "Tipo do imóvel", agência = "Verba mensal").
// CustomFieldDef é a definição (metadata); LeadCustomValue guarda o valor por lead.

model CustomFieldDef {
  id       String          @id @default(cuid())
  // Nome legível ("Convênio", "Tipo do imóvel"). Pode mudar sem quebrar nada.
  name     String
  // Identificador estável usado na URL/API. Slug do nome no momento da criação.
  // Não duplicar na mesma empresa.
  key      String
  type     CustomFieldType @default(TEXT)
  // Pra type=SELECT: array JSON de strings. Ex: ["Unimed","Bradesco","Particular"].
  options  Json?
  required Boolean         @default(false)
  // Ordem de exibição no drawer. Menor primeiro.
  order    Int             @default(0)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  values LeadCustomValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
  @@index([companyId, order])
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  LINK
}

model LeadCustomValue {
  id String @id @default(cuid())

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String

  field   CustomFieldDef @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  fieldId String

  // Valor sempre como texto — interpretação fica a cargo do `field.type`.
  // Pra DATE guarda ISO string; pra NUMBER guarda string numérica; SELECT
  // guarda o valor escolhido (uma das `options`). Simplifica muito o schema.
  value String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Um valor por (lead, field).
  @@unique([leadId, fieldId])
  @@index([fieldId])
}

// ─── Campos personalizados de EMPRESA ─────────────────────────────────────────
// Mesma ideia do CustomFieldDef (que é pra Lead), mas o alvo aqui é a própria
// `Company`. Definição pertence a um "tenant" (a empresa-dona, normalmente a
// agência que opera o LeadHub) e aplica-se a si mesma + às sub-empresas dela.
// Cada usuário da agência pode criar campos conforme o atendimento exigir
// (ex.: "Plano contratado", "Data de renovação", "Driver Stripe").

model CompanyCustomFieldDef {
  id      String          @id @default(cuid())
  name    String
  key     String
  type    CustomFieldType @default(TEXT)
  options Json?
  order   Int             @default(0)

  // Tenant que definiu o campo (a agência). Os campos visíveis em uma empresa
  // são os do parentCompanyId dela (ou os dela mesma se for top-level).
  ownerCompany   Company @relation("CompanyFieldDefOwner", fields: [ownerCompanyId], references: [id], onDelete: Cascade)
  ownerCompanyId String

  values CompanyCustomValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerCompanyId, key])
  @@index([ownerCompanyId, order])
}

model CompanyCustomValue {
  id String @id @default(cuid())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  field   CompanyCustomFieldDef @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  fieldId String

  value String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, fieldId])
  @@index([fieldId])
}

// Tarefa de follow-up de um lead (ligar, mandar proposta, agendar reunião…)
// Modelo simples e propositalmente enxuto — vendedor abre o sistema, vê
// "minhas tarefas de hoje", marca como feita e segue. Sem recorrência por agora.
model Task {
  id     String    @id @default(cuid())
  title  String
  dueAt  DateTime
  done   Boolean   @default(false)
  doneAt DateTime?
  notes  String?   @db.Text

  // Origem da tarefa: criada por humano ou disparada automaticamente
  // (ex: cliente abriu o link rastreado). Usado pra UI marcar "🔥 sinal quente"
  // e pra cooldowns de auto-criação.
  source TaskSource @default(MANUAL)

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  // Quem deve executar. Opcional — null = "qualquer um do setor pode pegar".
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId String?

  // Quem criou (auditoria, gamificação). Null = sistema.
  createdBy   User?   @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, done, dueAt])
  @@index([assigneeId, done, dueAt])
  @@index([leadId])
  @@index([leadId, source, done, createdAt])
}

enum TaskSource {
  MANUAL
  AUTO_LINK_OPEN // disparada quando cliente abriu o shortlink (proposta etc.)
}

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL
  CLOSED
  LOST
}

// ─── Comentários de Lead ──────────────────────────────────────────────────────

model LeadComment {
  id         String   @id @default(cuid())
  body       String   @db.Text
  authorName String   @default("Usuário")
  createdAt  DateTime @default(now())

  // Origem do comentário (pra dedup quando vem do ClickUp via webhook).
  // "LEADHUB" (default) | "CLICKUP"
  source     String  @default("LEADHUB")
  externalId String? // ID do comentário no ClickUp (evita criar duplicado em sync)

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String

  @@index([leadId])
  @@index([externalId])
}

// ─── Etapas de Pipeline Configuráveis ────────────────────────────────────────

model PipelineStageConfig {
  id       String  @id @default(cuid())
  pipeline String // "PROSPECCAO" | "LEADS" | "OPORTUNIDADES"
  name     String
  color    String  @default("#6366f1")
  order    Int     @default(0)
  isFinal  Boolean @default(false) // FECHADO / PERDIDO — etapas de encerramento

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  @@index([companyId, pipeline])
}

// ─── Contatos da Empresa (WhatsApp) ──────────────────────────────────────────

model CompanyContact {
  id        String   @id @default(cuid())
  name      String? // nome do contato / grupo
  phone     String // número (55...) ou group-id (@g.us)
  isGroup   Boolean  @default(false) // true = grupo do WhatsApp
  role      String   @default("CONTACT") // "CONTACT" | "DECISION_MAKER" | "TECHNICAL" | "FINANCIAL"
  hasAccess Boolean  @default(false) // acesso ao portal do cliente
  notes     String?
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  // Quando hasAccess = true, pode ter um User vinculado (login no portal)
  user   User?   @relation("ContactUser", fields: [userId], references: [id])
  userId String? @unique

  @@unique([companyId, phone])
  @@index([companyId])
}

// ─── Instâncias WhatsApp ──────────────────────────────────────────────────────

model WhatsappInstance {
  id            String         @id @default(cuid())
  // Slug técnico usado na Evolution API (auto-gerado, único, sem acento/espaço).
  // É a chave que casa mensagem↔instância em todo o sistema — não editar à mão.
  instanceName  String
  // Nome amigável que o usuário digita e vê na tela de gestão.
  // Fallback para instanceName quando ausente (instâncias antigas).
  label         String?
  phone         String?
  status        InstanceStatus @default(DISCONNECTED)
  webhookUrl    String?
  instanceToken String? // token da instância na Evolution API (para auth em endpoints específicos)
  // Aceita receber webhooks de mensagens de grupo. Default true (compat).
  // Quando false, sincroniza com Evolution `groupsIgnore=true` — a instância
  // permanece dentro dos grupos no WhatsApp e ainda pode enviar, mas para de
  // disparar webhook a cada mensagem. Útil em empresa com várias instâncias
  // nos mesmos grupos: deixa só 1 receptora, evita duplicação de processamento.
  acceptGroups  Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  messages   Message[]
  setores    SetorInstance[]
  assistants Assistant[]

  @@index([companyId])
}

enum InstanceStatus {
  CONNECTED
  DISCONNECTED
  CONNECTING
}

// ─── Mensagens WhatsApp ───────────────────────────────────────────────────────

model Message {
  id               String      @id @default(cuid())
  externalId       String?     @unique
  phone            String // telefone individual ou JID do grupo (@g.us)
  participantPhone String? // quem enviou dentro do grupo (preenchido só para mensagens de grupo)
  participantName  String? // nome do participante do grupo (pushName da Evolution API)
  body             String      @db.Text
  direction        MessageDir  @default(INBOUND)
  identifiedAs     LeadStatus?
  processed        Boolean     @default(false)
  rawPayload       Json?
  receivedAt       DateTime    @default(now())
  ack              Int? // ACK: 0=pending 1=server 2=delivered 3=read 4=played
  quotedId         String? // externalId da mensagem citada
  quotedBody       String?     @db.Text // snapshot do corpo da mensagem citada
  mediaBase64      String?     @db.Text // base64 da mídia (imagem/áudio) — vídeo/doc ignorados por tamanho
  mediaType        String? // MIME type: "image/jpeg", "audio/ogg; codecs=opus", etc.

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  instance   WhatsappInstance? @relation(fields: [instanceId], references: [id])
  instanceId String?

  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  campaignId String?

  lead   Lead?   @relation(fields: [leadId], references: [id])
  leadId String?

  // Conversa unificada — populada pelo backfill (Sprint 1) e por toda mensagem nova (Sprint 2)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String?

  // User que enviou a mensagem OUTBOUND (atendente). Visível só na UI interna
  // do LeadHub — auditoria e identificação de quem operou. Nullable para
  // mensagens antigas e mensagens automáticas (campanha, sistema).
  sentBy       User?   @relation("MessageSentBy", fields: [sentByUserId], references: [id])
  sentByUserId String?

  @@index([companyId])
  // Cobre `WHERE phone = X AND companyId = Y ORDER BY receivedAt DESC LIMIT N`
  // (rota /api/whatsapp/messages — abrir conversa). Substituiu o antigo
  // (phone, companyId) — Postgres usa prefixo, então queries que filtram só
  // pelos 2 primeiros continuam cobertas, e adicionou ordering pra evitar
  // sort em memória de 5k+ mensagens em grupos grandes.
  @@index([phone, companyId, receivedAt])
  @@index([processed])
  @@index([conversationId, receivedAt])
  @@index([sentByUserId])
}

enum MessageDir {
  INBOUND
  OUTBOUND
}

// ─── Regras de Identificação ──────────────────────────────────────────────────

model KeywordRule {
  id        String           @id @default(cuid())
  keyword   String
  mapTo     LeadStatus
  // CONTAINS: dispara quando a mensagem contém a expressão (busca parcial, padrão antigo).
  // EXACT: dispara apenas quando a mensagem (após trim/lower) é igual à expressão.
  matchMode KeywordMatchMode @default(CONTAINS)
  priority  Int              @default(0)
  createdAt DateTime         @default(now())

  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?

  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId String?

  @@index([companyId])
  @@index([campaignId])
}

enum KeywordMatchMode {
  CONTAINS
  EXACT
}

// ─── Configurações Globais ────────────────────────────────────────────────────

model Setting {
  key   String @id
  value String @db.Text
}

// Contador diário de mensagens enviadas por instância — protege contra
// banimento por uso de bot detectado pelo WhatsApp. Reseta naturalmente
// porque cada (instanceId, day) é uma linha nova.
model WhatsappQuota {
  id         String @id @default(cuid())
  instanceId String
  day        String // YYYY-MM-DD
  count      Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instanceId, day])
  @@index([day])
}

// ─── Conversation (CRM-style inbox) ──────────────────────────────────────────
// Uma Conversation envolve TODAS as mensagens trocadas com um telefone
// (individual ou grupo) dentro de uma empresa. Status, atribuição e SLA
// vivem aqui — não mais em Lead.attendanceStatus.

model Conversation {
  id String @id @default(cuid())

  // Identificação (telefone individual ou JID do grupo)
  phone   String
  isGroup Boolean @default(false)

  // Status e fluxo de atendimento
  status          ConversationStatus @default(OPEN)
  statusUpdatedAt DateTime           @default(now())

  // Atribuição
  assigneeId String? // User responsável (atendente que pegou)
  assignee   User?   @relation("ConversationAssignee", fields: [assigneeId], references: [id])
  setorId    String? // setor responsável (herdado da primeira instância que recebeu)
  setor      Setor?  @relation(fields: [setorId], references: [id])

  // Pré-cálculo da última mensagem (ordenação eficiente sem subquery)
  lastMessageAt        DateTime?
  lastMessageBody      String?     @db.Text
  lastMessageDirection MessageDir?
  unreadCount          Int         @default(0) // mensagens INBOUND não lidas pelo atendente

  // Retorno agendado
  scheduledReturnAt DateTime? // data/hora do retorno agendado (usado quando status=SCHEDULED)
  returnNote        String? // nota/motivo do agendamento

  // Gamificação — admin pode desligar pontos pra conversas internas (grupos
  // do time, testes etc). Default false = pontua normal.
  excludeFromGamification Boolean @default(false)

  // SLA
  firstResponseAt DateTime? // primeira resposta do atendente (calcula tempo de resposta)
  closedAt        DateTime?

  // Multi-tenant
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  // Metadados
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações inversas
  messages   Message[]
  notes      ConversationNote[]
  activities Activity[]
  leads      Lead[]

  @@unique([companyId, phone])
  @@index([companyId, status])
  @@index([companyId, lastMessageAt])
  @@index([assigneeId])
  @@index([setorId])
}

enum ConversationStatus {
  OPEN // 🆕 nova, aguardando ação (cyan)
  PENDING // 🔴 sem atendimento (passou SLA)
  IN_PROGRESS // 🟡 atendente atribuído e ativo
  WAITING_CUSTOMER // 🔵 respondemos, esperando cliente
  SCHEDULED // 🟣 standby — retorno agendado (usa Lead.expectedReturnAt como prazo)
  CLOSED // ⚪ finalizada
}

model ConversationNote {
  id         String   @id @default(cuid())
  body       String   @db.Text
  authorId   String?
  authorName String   @default("Sistema")
  // Tipo da nota — controla apresentação visual no chat:
  //   STANDARD  → amarelo/âmbar (anotação manual do atendente)
  //   SCHEDULED → roxo  (auto-gerada quando se agenda retorno)
  //   SYSTEM    → cinza (eventos automáticos diversos)
  type       String   @default("STANDARD")
  createdAt  DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  @@index([conversationId])
}

// ─── Activity (log universal) ─────────────────────────────────────────────────
// Registra eventos relevantes em Conversation, Lead ou Ticket. É o que
// alimenta a "linha do tempo" no modal e dashboards. NÃO duplica Message —
// mensagens vivem em Message; aqui ficam mudanças de estado, atribuições etc.

model Activity {
  id         String       @id @default(cuid())
  type       ActivityType
  body       String?      @db.Text
  meta       Json?
  authorId   String?
  authorName String?
  createdAt  DateTime     @default(now())

  // Pode pertencer a Conversation, Lead, Ticket (nullable — pelo menos um deve estar setado)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String?
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId         String?
  ticket         Ticket?       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId       String?

  // Multi-tenant
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  @@index([conversationId, createdAt])
  @@index([leadId, createdAt])
  @@index([ticketId, createdAt])
  @@index([companyId, createdAt])
}

enum ActivityType {
  STATUS_CHANGED
  ASSIGNEE_CHANGED
  SECTOR_CHANGED
  STAGE_CHANGED
  PIPELINE_CHANGED
  VALUE_CHANGED
  NOTE_ADDED
  CLICKUP_LINKED
  TRACKING_LINK_SET
  LEAD_LINKED
  CONVERSATION_REOPENED
  CONVERSATION_CLOSED
  TRANSFERRED
  // Extensível conforme necessário
}

// ─── Chamados (Helpdesk) ──────────────────────────────────────────────────────

model Ticket {
  id            String         @id @default(cuid())
  title         String
  description   String         @db.Text
  status        TicketStatus   @default(OPEN)
  priority      TicketPriority @default(MEDIUM)
  category      String?
  phone         String? // telefone WhatsApp de origem (quando criado via WhatsApp)
  clickupTaskId String? // ID ou URL da tarefa no ClickUp
  ticketStage   String? // etapa configurável do kanban de chamados
  // Visibilidade: isInternal=true → visível apenas ao SUPER_ADMIN (não aparece no portal do cliente)
  isInternal    Boolean        @default(false)

  // Tipo do registro:
  //   SUPPORT  — chamado de cliente externo (default, fluxo tradicional)
  //   INTERNAL — tarefa interna / afazer pessoal (sem cliente vinculado, fora do ClickUp)
  type String @default("SUPPORT")

  // Prazo previsto pra dar retorno/encerrar. Obrigatório no novo fluxo (validado
  // no API), mas mantido nullable no banco pra não quebrar registros antigos.
  dueDate DateTime?

  // Empresa-cliente do chamado (FOR quem é o atendimento). Diferente de
  // companyId, que é a empresa-dona do ticket (a agência). Para INTERNAL, null.
  clientCompany   Company? @relation("TicketClientCompany", fields: [clientCompanyId], references: [id])
  clientCompanyId String?

  // Atendente responsável (mesmo padrão da Conversation). Opcional.
  assignee   User?   @relation("TicketAssignee", fields: [assigneeId], references: [id])
  assigneeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  createdBy   User?   @relation("TicketCreatedBy", fields: [createdById], references: [id])
  createdById String?

  // Setor responsável — quem não pertence ao setor não enxerga o chamado
  setor   Setor?  @relation(fields: [setorId], references: [id])
  setorId String?

  // Projeto ao qual o chamado foi agrupado. Quando vinculado a um projeto com
  // ClickUp, a task do chamado vive na lista do projeto (não na lista padrão).
  projeto   SetorClickupList? @relation("TicketProjeto", fields: [projetoId], references: [id], onDelete: SetNull)
  projetoId String?

  // Visibilidade: "OPEN" (toda a empresa vê) | "RESTRICTED" (só setor do chamado
  // + pessoas extras em accessUsers + assignee/criador). ADMIN/SUPER_ADMIN sempre
  // veem. Default OPEN mantém compat com chamados antigos.
  visibility String @default("OPEN")

  messages    TicketMessage[]
  activities  Activity[]
  accessUsers TicketAccessUser[]

  @@index([companyId])
  @@index([status])
  @@index([setorId])
  @@index([assigneeId])
  @@index([clientCompanyId])
  @@index([dueDate])
  @@index([projetoId])
}

model TicketMessage {
  id         String  @id @default(cuid())
  body       String  @db.Text
  isInternal Boolean @default(false)
  authorName String
  authorRole String  @default("CLIENT")

  // Anexos de imagem em base64 — mesmo padrão de Message do WhatsApp.
  // Mantemos no DB pra simplificar (sem storage externo). Vídeos/docs grandes
  // devem ser linkados em vez de embutidos.
  mediaBase64 String? @db.Text
  mediaType   String? // MIME: "image/jpeg", "image/png", etc.

  // Origem da mensagem (pra audit + dedup quando vem do ClickUp).
  // "LEADHUB" (default) | "CLICKUP" | "CLIENT_PORTAL"
  source     String  @default("LEADHUB")
  externalId String? // ID do comentário no ClickUp (evita criar duplicado em sync)

  createdAt DateTime @default(now())

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  @@index([ticketId])
  @@index([externalId])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── Setores (controle de acesso interno por departamento) ────────────────────

model Setor {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  // Permissões do setor
  canManageUsers     Boolean @default(false) // cadastrar/editar usuários
  canViewLeads       Boolean @default(true) // ver prospects/leads/oportunidades
  canCreateLeads     Boolean @default(false) // cadastrar/mover leads
  canViewTickets     Boolean @default(true) // ver chamados do setor
  canCreateTickets   Boolean @default(true) // abrir chamados
  canViewConfig      Boolean @default(false) // acessar configurações
  canUseAI           Boolean @default(false) // usar Assistente IA e sugestões
  canViewInbox       Boolean @default(true) // acessar caixa de entrada WhatsApp
  canSendMessages    Boolean @default(true) // enviar mensagens WhatsApp
  canViewCompanies   Boolean @default(false) // ver lista de empresas/clientes
  canCreateCompanies Boolean @default(false) // cadastrar novas empresas
  // Permissões de módulo (gate da Sidebar, gateadas pelos módulos da empresa).
  // Default true mantém compat — empresas que ligam módulo já distribuíam acesso
  // a todos os usuários. Admin pode restringir setor a setor.
  canViewCalendario  Boolean @default(true) // ver Calendário
  canViewMarketing   Boolean @default(true) // ver Dashboard de Marketing
  canViewCampanhas   Boolean @default(true) // ver Campanhas
  canViewProjetos    Boolean @default(true) // ver Projetos
  canViewRanking     Boolean @default(true) // ver Ranking de gamificação
  canViewLinks       Boolean @default(true) // ver Links de rastreamento
  canViewCofre       Boolean @default(true) // ver Cofre (2FA continua valendo por credencial)

  users         SetorUser[]
  instances     SetorInstance[]
  tickets       Ticket[]
  conversations Conversation[]
  clickupLists  SetorClickupList[]

  @@index([companyId])
}

// Project: lista do ClickUp atrelada a um setor com gestão própria de prazo,
// status e equipe. Tarefas detalhadas vivem no ClickUp; o LeadHub controla
// o nível "macro" (entrega, prazo, membros).
//
// Mantém o nome SetorClickupList por compatibilidade com a migration anterior;
// representa um Project completo.
model SetorClickupList {
  id      String @id @default(cuid())
  setorId String
  setor   Setor  @relation(fields: [setorId], references: [id], onDelete: Cascade)

  clickupListId   String
  name            String
  description     String?  @db.Text
  type            String? // "SITE" | "MIDIA" | "CAMPANHA" | etc.
  clientCompanyId String?
  clientCompany   Company? @relation("SetorClickupListClient", fields: [clientCompanyId], references: [id], onDelete: SetNull)

  // Gestão de projeto
  status      ProjectStatus @default(PLANEJAMENTO)
  startDate   DateTime?
  dueDate     DateTime?
  deliveredAt DateTime?

  // Visibilidade: "OPEN" (toda a empresa vê) | "RESTRICTED" (só setor do projeto
  // + membros + pessoas extras em accessUsers). ADMIN/SUPER_ADMIN sempre veem.
  visibility String @default("OPEN")

  // Cache de sync vindo do ClickUp via cron
  taskCount      Int       @default(0)
  taskCompleted  Int       @default(0)
  taskOverdue    Int       @default(0)
  taskNoDueDate  Int       @default(0) // tarefas sem due_date
  taskNoAssignee Int       @default(0) // tarefas sem responsável
  lastSyncedAt   DateTime?

  // Acompanhamento de cobrança ao cliente (quando AGUARDANDO_CLIENTE)
  clientExpectedAt    DateTime? // próxima vez que se espera retorno
  clientLastContactAt DateTime? // última cobrança registrada

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       ProjectMember[]
  taskStates    ProjectTaskState[]
  activities    ProjectActivity[]
  tickets       Ticket[]            @relation("TicketProjeto")
  internalTasks ProjectTask[]
  accessUsers   ProjectAccessUser[]

  @@unique([setorId, clickupListId])
  @@index([setorId])
  @@index([clientCompanyId])
  @@index([status])
  @@index([dueDate])
}

// Tarefa NATIVA do LeadHub dentro de um projeto — não vive no ClickUp.
// É o que permite usar Projetos sem depender do ClickUp. Tarefas que devem
// ir pro ClickUp NÃO usam este modelo: são criadas direto na lista do projeto
// e aparecem via ProjectTaskState (snapshot do sync).
model ProjectTask {
  id          String           @id @default(cuid())
  projectId   String
  project     SetorClickupList @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?          @db.Text
  done        Boolean          @default(false)
  priority    TicketPriority   @default(MEDIUM)
  dueDate     DateTime?

  assignee   User?   @relation("ProjectTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId String?

  createdBy   User?   @relation("ProjectTaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId, done])
  @@index([assigneeId])
}

// Pessoas extras autorizadas a ver um chamado RESTRICTED (além do setor).
model TicketAccessUser {
  ticketId String
  userId   String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
  @@index([userId])
}

// Pessoas extras autorizadas a ver um projeto RESTRICTED (além do setor/membros).
model ProjectAccessUser {
  projectId String
  userId    String
  project   SetorClickupList @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

// Snapshot do estado das tarefas do ClickUp — usado pra comparar entre syncs
// e detectar criações, atualizações e conclusões.
model ProjectTaskState {
  id            String           @id @default(cuid())
  projectId     String
  project       SetorClickupList @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId        String // ID no ClickUp
  name          String
  statusName    String?
  isCompleted   Boolean          @default(false)
  hasNoAssignee Boolean          @default(false)
  dueDate       BigInt? // epoch ms (vindo do ClickUp; null = sem prazo)
  dateUpdated   BigInt? // epoch ms
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([projectId, taskId])
  @@index([projectId])
}

// Log de eventos sobre tarefas e cobranças — alimenta o histórico no detail.
model ProjectActivity {
  id          String           @id @default(cuid())
  projectId   String
  project     SetorClickupList @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String // "TASK_CREATED" | "TASK_UPDATED" | "TASK_COMPLETED" | "CLIENT_FOLLOWUP"
  taskName    String // nome da tarefa (ou "Cobrança ao cliente" pra followup)
  taskId      String // ID da task ou string vazia pra followup
  description String?          @db.Text // texto livre (mensagem da cobrança, ex)
  authorId    String?
  authorName  String?
  createdAt   DateTime         @default(now())

  @@index([projectId, createdAt])
}

enum ProjectStatus {
  PLANEJAMENTO
  EM_ANDAMENTO
  AGUARDANDO_CLIENTE // pausa penalidades de prazo (a culpa não é da equipe)
  PAUSADO
  ENTREGUE
  CANCELADO
}

model ProjectMember {
  projectId String
  project   SetorClickupList @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String           @default("MEMBER") // "LEAD" | "MEMBER"
  createdAt DateTime         @default(now())

  @@id([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// Pivot: usuário ↔ setor (N:N — um usuário pode pertencer a vários setores)
model SetorUser {
  setorId String
  userId  String

  setor Setor @relation(fields: [setorId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([setorId, userId])
}

// Pivot: setor ↔ instância WhatsApp (N:N)
model SetorInstance {
  setorId    String
  instanceId String

  setor    Setor            @relation(fields: [setorId], references: [id], onDelete: Cascade)
  instance WhatsappInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@id([setorId, instanceId])
}

// ─── Cofre de credenciais ─────────────────────────────────────────────────────
//
// CompanyAsset é qualquer "recurso digital" que gerenciamos para o cliente:
// domínio, hospedagem, site, conta de e-mail, banco, repositório, etc.
// CompanyCredential guarda usuário+senha (criptografada) vinculados a um asset.
// CredentialAccessLog audita quem visualizou cada credencial.

model CompanyAsset {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type       AssetType
  name       String
  url        String?
  host       String? // ex: "ftp.cliente.com.br", "mysql.cliente.com.br:3306"
  identifier String? // ex: nome do domínio "cliente.com.br", e-mail "vendas@x"
  provider   String? // ex: "Hostinger", "Cloudflare", "Google Workspace"
  status     AssetStatus @default(ACTIVE)
  expiresAt  DateTime? // renovação de domínio, validade de SSL, etc.
  notes      String?     @db.Text
  tags       String[]    @default([])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  credentials CompanyCredential[]

  @@index([companyId, type])
  @@index([companyId, expiresAt])
}

enum AssetType {
  DOMAIN
  HOSTING
  WEBSITE
  EMAIL_ACCOUNT
  DATABASE
  DNS_PROVIDER
  REPOSITORY
  SOCIAL_ACCOUNT
  ANALYTICS
  CLOUD_SERVICE
  OTHER
}

enum AssetStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  ARCHIVED
}

model CompanyCredential {
  id      String       @id @default(cuid())
  assetId String
  asset   CompanyAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  label             String // ex: "Admin WordPress", "FTP root", "cPanel"
  username          String?
  // Segredo criptografado (AES-256-GCM). Nunca armazenado em texto claro.
  // Formato no banco: base64(iv|authTag|ciphertext)
  passwordEncrypted String?
  url               String? // link de login direto
  totpSecret        String? // (opcional, criptografado tb) — backlog Fase 2
  notes             String? @db.Text

  lastRotatedAt    DateTime? // alerta para trocar senhas a cada N meses
  sharedWithClient Boolean   @default(false) // já foi compartilhada com o cliente?
  sharedAt         DateTime?

  // Soft-delete (arquivamento). CLIENT não apaga credencial — arquiva.
  // Admin/SUPER_ADMIN veem arquivadas, podem restaurar ou apagar de vez.
  archivedAt     DateTime?
  archivedById   String?
  archivedByName String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  accessLogs CredentialAccessLog[]

  @@index([assetId])
  @@index([assetId, archivedAt])
}

model CredentialAccessLog {
  id           String            @id @default(cuid())
  credentialId String
  credential   CompanyCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  // Denormalizado: facilita filtro "tudo que fulano viu na empresa X"
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId    String?
  userName  String? // snapshot (caso o user seja deletado)
  userRole  String?
  action    CredentialAction
  ipAddress String?
  userAgent String?
  createdAt DateTime         @default(now())

  @@index([credentialId, createdAt])
  @@index([companyId, createdAt])
}

enum CredentialAction {
  REVEAL // visualizou a senha
  COPY // copiou para o clipboard
  SHARE // compartilhou com o cliente (WhatsApp/email)
  EDIT // editou o registro
  CREATE
  DELETE
  ARCHIVE // arquivou (soft-delete por CLIENT)
  RESTORE // admin restaurou um registro arquivado
}

// ─── Integrações de Marketing ─────────────────────────────────────────────────
//
// MarketingIntegration: 1 conexão OAuth do cliente com um provedor (GA4, SC, GBP, Ads).
// Tokens são gravados criptografados (AES-256-GCM via src/lib/crypto.ts).
//
// Fontes de dados são puxadas via cron diário e gravadas em tabelas resumidas:
// AnalyticsSnapshot (1 linha/dia/empresa) — KPIs gerais
// AnalyticsTopPage / TrafficSource / GeoData — quebras dimensionais por dia
// SearchConsoleQuery — top queries por dia

model MarketingIntegration {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  provider     IntegrationProvider
  // Conta/propriedade conectada (ex: "properties/123456" pra GA4, "sc-domain:x.com" pra SC)
  accountId    String?
  accountLabel String? // nome amigável (ex: "azz.com.br")

  // OAuth tokens (criptografados)
  accessTokenEnc  String?   @db.Text
  refreshTokenEnc String?   @db.Text
  tokenExpiresAt  DateTime?
  scopes          String[]  @default([])

  // Identidade do usuário Google que autorizou
  googleEmail String?
  googleName  String?

  status         IntegrationStatus @default(ACTIVE)
  lastSyncAt     DateTime?
  lastSyncStatus String? // "ok" | "error: ..."
  lastError      String?           @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@unique([companyId, provider, accountId])
  @@index([companyId])
  @@index([status, lastSyncAt])
}

enum IntegrationProvider {
  GA4 // Google Analytics 4
  SEARCH_CONSOLE // Google Search Console
  BUSINESS_PROFILE // Google Meu Negócio (GBP)
  GOOGLE_ADS
  META_ADS
}

enum IntegrationStatus {
  ACTIVE
  EXPIRED // refresh token inválido / revogado
  ERROR // falha repetida no sync
  DISCONNECTED // usuário desconectou manualmente
}

// ─── Instagram — Automação estilo ManyChat ─────────────────────────────────────
//
// Conexão via "API com Login do Instagram" (fluxo novo da Meta, sem Página do
// Facebook). Diferente de MarketingIntegration (dados organicos via Windsor),
// aqui guardamos a conta para AÇÃO: responder comentários e mandar DM.
//
// Fluxo do módulo:
//   1. Empresa conecta a conta IG → InstagramAccount (token longo 60d cifrado).
//   2. Webhook (/api/webhook/instagram) recebe `comments` e `messages`.
//   3. IgAutomation casa comentário↔regra por palavra-chave no post escolhido.
//   4. Ações: responde o comentário publicamente + manda DM (private reply).
//   5. Follow-gate opcional: só libera o link depois de confirmar follow
//      (is_user_follow_business no contexto de DM — best-effort, igual ManyChat).
//   6. Cada disparo vira IgAutomationRun (idempotência + métricas).

model InstagramAccount {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // ID numérico da conta IG (do token / GET /me). Chave que casa o webhook
  // (entry[].id) de volta com a empresa dona da conta.
  // id do /me (user_id). NEM SEMPRE é o mesmo que o webhook usa em entry.id —
  // o Instagram tem 2 namespaces. Por isso guardamos os dois e casamos por
  // qualquer um (ver findAccountByWebhookId).
  igUserId          String  @unique
  // id app-scoped que o webhook envia em entry.id (campo `id` do /me).
  igScopedId        String?
  username          String?
  name              String?
  profilePictureUrl String? @db.Text

  // Token de longa duração (60 dias) cifrado (AES-256-GCM) + validade para o
  // cron renovar antes de expirar (ig_refresh_token).
  accessTokenEnc String?   @db.Text
  tokenExpiresAt DateTime?
  scopes         String[]  @default([])

  status    IntegrationStatus @default(ACTIVE)
  lastError String?           @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  automations IgAutomation[]
  runs        IgAutomationRun[]

  @@index([companyId])
  @@index([status, tokenExpiresAt])
  @@index([igScopedId])
}

model IgAutomation {
  id        String           @id @default(cuid())
  companyId String
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId String
  account   InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name    String
  enabled Boolean @default(true)

  // Post-alvo: null = qualquer post da conta; senão o media id do IG.
  mediaId    String?
  mediaLabel String? // legenda curta / thumb pra UI

  // Gatilho por comentário
  triggerType IgTriggerType @default(KEYWORD)
  // Palavras-chave (lower-case). Vazio + triggerType=ANY = qualquer comentário.
  keywords    String[]      @default([])

  // Ação 1: resposta pública ao comentário
  replyToComment Boolean  @default(true)
  // Lista de respostas — escolhe uma aleatória pra não parecer robô.
  commentReplies String[] @default([])

  // Ação 2: DM (private reply) ao autor do comentário
  sendDm        Boolean @default(true)
  dmText        String? @db.Text
  dmLinkUrl     String?
  dmButtonLabel String?

  // Follow-gate: só libera o link/DM final depois de confirmar o follow.
  requireFollow    Boolean @default(false)
  notFollowingText String? @db.Text // "me segue aqui e responde 'ok' que te mando 🚀"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs IgAutomationRun[]

  @@index([companyId])
  @@index([accountId, enabled])
  @@index([mediaId])
}

model IgAutomationRun {
  id           String           @id @default(cuid())
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId    String
  account      InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  automationId String?
  automation   IgAutomation?    @relation(fields: [automationId], references: [id], onDelete: SetNull)

  // Quem comentou / abriu DM
  igCommenterId String
  username      String?

  // Origem do disparo
  mediaId     String?
  commentId   String?
  commentText String? @db.Text

  status      IgRunStatus   @default(PENDING)
  followState IgFollowState @default(UNKNOWN)
  errorDetail String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Idempotência: no máximo 1 disparo por comentário por automação.
  @@unique([automationId, commentId])
  @@index([companyId])
  @@index([accountId, status])
  @@index([igCommenterId])
}

enum IgTriggerType {
  KEYWORD // comentário contém alguma das palavras-chave
  ANY // qualquer comentário no post dispara
}

enum IgRunStatus {
  PENDING
  COMMENT_REPLIED
  DM_SENT
  AWAITING_FOLLOW // mandou pedido de follow, esperando confirmação
  COMPLETED
  FAILED
  SKIPPED
}

enum IgFollowState {
  UNKNOWN
  NOT_FOLLOWING
  FOLLOWING
}

model AnalyticsSnapshot {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  source    String // "ga4" | "pixel" (futuramente)

  sessions        Int    @default(0)
  users           Int    @default(0)
  newUsers        Int    @default(0)
  pageviews       Int    @default(0)
  conversions     Int    @default(0)
  bounceRate      Float? // 0..1
  avgSessionSec   Float?
  engagedSessions Int?   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, date, source])
  @@index([companyId, date])
}

model AnalyticsTopPage {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  source    String // "ga4"

  pagePath   String
  pageTitle  String?
  views      Int     @default(0)
  users      Int     @default(0)
  avgTimeSec Float?

  @@unique([companyId, date, source, pagePath])
  @@index([companyId, date])
}

model AnalyticsTrafficSource {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  source    String // "ga4"

  // Dados brutos do GA4
  rawSource String // ex: "google", "instagram.com", "chatgpt.com"
  rawMedium String // ex: "organic", "referral", "cpc"

  // Categoria classificada pela nossa lógica (src/lib/traffic-classifier.ts)
  bucket String // "AI" | "ORGANIC_SEARCH" | "PAID_SEARCH" | "INSTAGRAM" | ...

  sessions    Int @default(0)
  users       Int @default(0)
