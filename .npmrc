# React 19 quebra peer deps de algumas libs que ainda declaram React 17/18
# (ex: react-simple-maps). Elas funcionam em runtime, só não atualizaram peers.
# legacy-peer-deps=true faz npm ci ignorar esses conflitos durante o build.
legacy-peer-deps=true

# Resiliência de rede no `npm ci` do Docker build (runner do GitHub).
# Sem isso, um timeout transitório do registry npm derruba o build inteiro
# (exit code 1). Com retry + backoff, o download falho é re-tentado até 5x.
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=300000
